role: 에이전트 플러그인의 원본 형식 (ticket slcode-agent-plugin, 설계 ws docs/report/slcode-agent-plugin-survey.md 커밋 12ffcf2, 사용자 결정 2026-10-26·27) — Claude 플러그인 형식을 따른다. manifest slcode-plugin.json {name, version, options {<이름>: {type boolean|string|number, default, label}}, parts {<이름>: {required, default, when}}, env}. part 폴더마다 skills/·hooks/hooks.json·.mcp.json·bin/·instructions/*.md(frontmatter if — boolean 옵션 이름, ! 로 부정)·raw/claude/(Claude 플러그인 폴더 형식, session.json 은 SDK settings)·raw/pi/. part 를 켜는 조건 when 은 세션 인자 param 만 본다 (ticket slcode-agent-plugin-part-when, 사용자 결정 2026-11-02 — slcode-agent-plugin-survey 의 "when 없음" 을 param 에 한해 바꿈. env 를 보지 않는 것은 셸에서 붙인 값과 부모 세션에서 물려받은 값이 섞여서): when {param {NAME: true(있고 비어 있지 않음) | "값"(같음) | ["값", …](그중 하나)}}, 이름 여럿은 모두 참이어야. 그 밖의 실행 환경 조건은 플러그인이 실행할 때 확인한다. 옛 slcode-plugin(0.1.0)은 when 을 모르는 칸으로 넘겨 그 part 를 조건 없이 다룬다(실측) — 그래서 형식 판을 올리지 않는다. 형식이 모르는 폴더·파일은 오류가 아니다; manifest 가 없거나 깨진 경우(이름·part 구성을 알 수 없음, part·옵션 이름이 겹침)만 던진다 — slcode plugin add 가 거부하는 유일한 경우. 파일을 쓰지 않는다. 하네스는 claude·gpt(GPT 하네스, 장기적으로 Codex 자리 — 설계 기준)·codex. BUILDER 는 빌드기 판 — 빌드 결과가 달라지는 변경이면 올린다(빌드 식별자에 들어가 옛 빌드를 다시 쓰지 않는다). 바깥 hooks/hooks.json 은 slcode 형식(항목 목록, agentHooks) — partLost 는 Codex 에 파일째 빠짐, GPT 에는 command 항목 중 GPT 가 받지 않는 이벤트를 적는다(raw/claude 의 것은 Claude 형식). 상수 — BUILDER: 빌드기 판 — 빌드 결과가 달라지면 올린다(빌드 식별자에 들어가 옛 빌드를 다시 쓰지 않게). 2 는 slcode 형식 hooks.json·js/ts 훅 묶기(slcode-agent-plugin-hooks). 5 는 export 훅 명령이 상태 폴더의 고정 런처를 부르는 것(slcode-plugin-split).

export val MANIFEST
export val BUILDER
export val HARNESSES
export val PARAM_NAME
type Harness
type OptionType
type OptionSpec
type When
type PartSpec
export val ADDON_MANIFEST
type AddonSpec
type Manifest
type Values
type Resolved
export fn parseManifest(text) -> Manifest {
  role: 꼴 검사 — 이름은 [A-Za-z0-9][A-Za-z0-9._-]{0,63}(.. 없음, 폴더 이름이 된다). required part 는 늘 켜짐, default 를 적지 않은 part 는 켜짐. when 은 part·param·env 중 하나 이상을 쓴 {part: {이름: true}, param: {NAME: 값}, env: {NAME: 값}} 꼴만 — NAME 은 [A-Za-z_][A-Za-z0-9_]*, 값이 true·문자열·빈 것이 아닌 문자열 목록이 아니거나 적은 칸이 비면 던진다. part 는 true 만 받는다(ticket slcode-agent-plugin-part-when-part, 사용자 확정 2026-11-03 — param 의 목록은 "그중 하나" 라서 목록을 받으면 같은 칸에서 뜻이 갈린다). 없는 part 이름·자기 참조·순환도 던진다. 옵션 default 가 없으면 꼴의 0 값
}
export fn readManifest(dir) -> Manifest {
  role: slcode-plugin.json 또는 slcode-addon.json (ticket slcode-plugin-addon). 애드온은 파일 이름으로 나눈다 — slcode-plugin.json 에 addon 칸만 더하면 옛 사본이 독립 플러그인으로 설치하고(0.3.0·0.4.0 실측), 파일이 다르면 옛 사본의 add 가 항상 거절한다. slcode-plugin.json 의 addon 칸, 두 파일 함께, addon 칸 없는 slcode-addon.json 은 던진다
}
export fn versionHolds(version, range) -> Bool {
  role: 애드온의 판 조건 — 1.2.3, ^, ~, >=, >, <=, <, *, 공백은 AND. 의존성이 없는 패키지라 쓰는 범위만 직접 구현한다. 프리릴리스는 같은 x.y.z 의 정식 판보다 낮은 것으로만 본다. 판이나 조건을 읽지 못하면 거짓
}
export fn partRoot(dir, m, part) -> Path {
  role: part 가 있는 폴더 — 합친 manifest 는 m.roots 로 part 마다 다르고, 아니면 dir
}
export fn walk(dir, rel) -> String[] {
  role: 일반 파일의 상대 경로(/ 구분, 정렬), 링크는 따라가고 .git 은 뺀다
}
export fn sourceFiles(dir, m) -> String[] {
  role: manifest 와 manifest 에 적힌 part 폴더의 파일 — 설치가 복사하고 해시하는 범위
}
export fn sourceHash(dir, m) -> Text {
  role: 경로·실행 비트·내용의 sha256 — 같으면 add 가 아무것도 하지 않는다
}
export fn frontmatter(text) -> Frontmatter {
  role: 머리 --- 블록의 맨 앞 칸 키와 값, 나머지는 body. 한 줄 값은 따옴표를 벗긴다. 블록 스칼라(| >, 끝맺음 표시 포함)와 들여 쓰거나 빈 이어지는 줄은 값에 잇는다 — | 는 줄바꿈, 그 밖은 공백(실제 skill 의 description 이 여러 줄이다, slcode-agent-plugin-codex). 중첩 맵은 키만 쓴다
}
export fn mcpTransport(def) -> Text {
  role: .mcp.json 서버 하나의 연결 방식 — type 이 없으면 stdio(Claude 와 같다). stdio 는 command, http 는 url 이 있어야 그 이름, 아니면 사유. Codex 는 stdio·http 만 받는다
}
export fn partLost(dir, part) {
  role: part 하나에서 하네스마다 빠지는 것("<part>/<경로>[: 사유]") — 호환 등급과 report.json 의 lost 가 같은 규칙을 쓴다. codex: hooks/hooks.json·raw/claude·raw/pi·Claude 전용 skill 필드(name·description·when_to_use·disable-model-invocation 밖)·.mcp.json 의 stdio·http 가 아닌 서버(mcpTransport). gpt: GPT 하네스가 받지 않는 훅 이벤트(SessionStart·UserPromptSubmit·PreToolUse·PostToolUse·Stop·PreCompact·PostCompact·SessionEnd 밖)·raw/claude·Claude 전용 skill 필드. claude: raw/pi. 문법이 깨진 hooks.json·.mcp.json(raw/claude 의 것과 session.json 은 Claude 만)은 그것을 받는 하네스 모두
}
export fn compat(dir, m) {
  role: 호환 등급 — 모든 part(켜지 않은 것도)의 partLost 를 모아, 어느 하네스에도 빠지는 것이 없으면 full, 아니면 partial
}
export fn userValues(m, layers) -> Resolved {
  role: manifest 기본값 위에 층(기본 설정 config.json < 프로필 < 세션)을 차례로 덮는다 — 뒤가 이긴다. 모르는 키·꼴이 틀린 값·필수 part 끄기는 건너뛴다(옛 판의 설정이 남아 있을 수 있다). part 조건 when 은 보지 않는다 — 사용자 설정 그대로(목록·관리 화면 스위치·export excluded)
}
export fn resolveValues(m, layers, params, env) -> Resolved {
  role: 빌드에 쓰는 값 — userValues 다음 when 이 있는 켠 part 는 params(세션 인자)·env·다른 part 의 최종 상태로 조건이 참일 때만 남긴다. 대상 part 를 먼저 판단하므로 사슬도 manifest 순서와 상관없다 — 사용자가 끈 part 는 켜지 않고, 필수 part 도 조건이 거짓이면 꺼진다(사용자 결정 2026-11-02). params·env 를 주지 않으면(기본 빌드·export 판) 없는 것으로 본다. param·env 값은 빌드 식별자에 들어가지 않는다 — 켜진 part 만 설정 문자열에 남는다
}
export fn whenHolds(when, params, env, partOn) -> Bool {
  role: when 조건 하나 — part 는 partOn 이 참인가. param·env 는 이름마다 true 는 값이 있고 비어 있지 않음, 문자열은 같음, 목록은 그중 하나. 세 칸과 이름 모두 참이어야 참
}
export fn whenText(when) -> Text {
  role: 화면·목록·export excluded 에 보이는 조건 글 — part main, param ORCH_ROLE, param ORCH_ROLE=worker, env FLAG=a|b 를 part·param·env 순서로 공백으로 잇는다
}
export fn valuesString(r) -> Text {
  role: 정렬한 설정 문자열 part.<이름>=0|1, opt.<이름>=<JSON>
}
export fn buildId(values, hash, harness) -> Text {
  role: 설정 문자열·원본 해시·하네스·BUILDER 의 sha256 앞 16자 — 빌드 폴더 이름
}
export fn parseAssignment(m, s) {
  role: slcode plugin set 의 <키>=<값> — part 는 on|off(필수 part 의 off 는 오류), boolean 옵션은 true|false|on|off, number 는 유한한 수, string 은 그대로. 모르는 키는 part·옵션 목록과 함께 오류
}
export val COMMANDS_DIR
export val CLAUDE_BUILTIN_COMMANDS
export fn commandFiles(dir, part) {
  role: 명령 (ticket slcode-agent-plugin-command) — part 의 commands/<이름>/COMMAND.ts|js. COMMAND 파일이 없는 commands/ 아래 폴더(공용 코드)는 명령이 아니다. 이름이 hookApi.COMMAND_NAME 밖이거나 .ts·.js 가 함께 있으면 errors
}
export fn parseAliases(text) -> Text[] {
  role: SKILL.md 머리의 aliases 를 읽는다 — [b, ut]·b·블록 목록. frontmatter() 는 목록을 잇기만 하므로 머리 줄을 따로 읽는다. 이름 규칙은 aliasErrors 와 빌드가 본다
}
export fn skillAliases(dir, part) {
  role: part 하나의 skill 별칭 (ticket slcode-plugin-skill-alias, 사용자 결정 2026-11-05) — 원본 SKILL.md frontmatter 의 aliases([b, ut]·b·블록 목록)를 skills/·raw/claude/skills/ 에서 읽는다. 선언이 원본에 있으므로 part 를 끄면 함께 빠지고 별칭의 연쇄는 skill 이름과의 겹침으로 거부된다. 명령 별칭은 두지 않는다 — 얇은 COMMAND.ts 의 import 한 줄로 된다(실측)
}
fn skillNames(dir, part) {
  role: 같은 플러그인의 부를 수 있는 이름 — skills/<폴더>(와 frontmatter name), raw/claude/skills/<폴더>, 그 별칭. 소문자
}
export fn aliasErrors(dir, m) -> Text[] {
  role: 별칭의 정적 검사 — 모든 part(켜지 않은 것도): 이름 규칙(COMMAND_NAME), 자기 자신, 같은 플러그인 skill 이름, 다른 skill 의 별칭, CLAUDE_BUILTIN_COMMANDS 와 같은 이름(사용자 결정 2026-11-05 — /init 은 내장 명령이 실행되어 짧은 이름으로 부를 수 없다). 같은 폴더의 skill 을 뒤 part 가 덮는 경우의 같은 별칭은 겹침이 아니다. 명령과의 겹침은 commandErrors 가 skillNames 로 본다. 하나라도 있으면 add 가 거부한다
}
export fn commandErrors(dir, m) -> Text[] {
  role: 명령의 정적 검사 — 모든 part(켜지 않은 것도): commandFiles 의 errors, part 끼리 같은 명령, 같은 플러그인 skill 과 같은 이름, CLAUDE_BUILTIN_COMMANDS(Claude 내장 명령 이름·별칭의 정적 목록 — SDK 0.3.282 supportedCommands builtin 실측, 사용자 결정 2026-11-02)와 같은 이름. 하나라도 있으면 add 가 거부한다(사용자 결정 2026-11-02 — 플러그인 적용 실패). partLost 는 명령을 gpt·codex 가 잃는 것으로 적는다(slcode 의 Claude 세션 전용). BUILDER 6: 빌드가 commands/ 를 플러그인 폴더에서 빼고 commands.json 을 쓴다
}
