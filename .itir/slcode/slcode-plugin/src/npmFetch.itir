role: npm 레지스트리에서 패키지 tarball 을 받아 푼다 — typescript(scriptCheck)·esbuild(esbuild.ts)를 처음 필요할 때 받는 데 쓴다. 버전·무결성(sha512, pnpm-lock 의 것)은 부르는 쪽이 고정한다. 상수 — FETCH_MS: 한 tarball 60초.

export val REGISTRY
val FETCH_MS
export fn untar(buf, dest) {
  role: npm tarball(ustar) 의 일반 파일만 푼다, .. 경로는 버린다. 실행 비트를 남긴다(esbuild 바이너리)
}
export fn fetchTarball(url, integrity) {
  role: 받아 무결성을 대조한 뒤 gunzip 한 tar — 맞지 않거나 HTTP 실패면 던진다
}
export fn placeDir(dir, fill) {
  role: 옆 임시 폴더를 채운 뒤 rename — 동시에 받았으면 먼저 놓인 것을 쓴다
}
