role: js/ts 훅 worker (ticket slcode-agent-plugin-hooks) — 플러그인 하나의 스크립트들을 이 worker_threads 안에서 싣고 콜백을 부른다(한 플러그인의 오류·무한 루프가 core 와 다른 플러그인을 멈추지 못한다). 로컬 모듈은 형만 가져온다 — 이벤트·메서드 표는 core 가 workerData 로 준다(테스트의 tsx 가 worker 에는 붙지 않는다, 2026-10-29 실측; node 22 는 .ts worker 를 형 지우기로 싣는다). 기동: 스크립트마다 import 하고(묶인 slcode/api 사본이 globalThis 의 수집기에 slcode.on() 을 넣는다) 등록을 ready 로 알린다 — slcode.run() 뒤(또는 import 가 끝난 뒤)의 on() 은 무시·경고, 싣다가 던진 스크립트·옛 꼴(default 함수만 있고 등록 없음)은 버린다, slcode.run() 이 없으면 경고만. 띄우는 쪽은 hookRunner — slcode core 안 또는 export 의 세션 중간 프로세스(hookBroker) 안. 목록 모드(메인 스레드, --list <스크립트>): 같은 싣기로 등록만 JSON 한 줄로 내고 곧바로 끝난다 — 빌드(agentHooks.listScript)가 따로 띄운 node 로 부른다. 상태: 에이전트(주 '' · 서브에이전트 id)마다 객체 하나를 같은 플러그인의 콜백들이 함께 본다(사용자 결정 A — 동시에 n 을 셋이 올리면 3). 콜백이 끝나면 저장한 값과 비교해 바뀐 키만 core 에 보낸다. 함수가 끝난 뒤의 메서드 호출·그 이벤트에서 쓸 수 없는 메서드는 무시·경고. 상수 — STATE_LIMIT: 플러그인 하나(에이전트 하나)의 상태 1MB — 넘는 변경은 저장하지 않고 경고. 바뀔 때마다 파일 전체를 다시 쓰기 때문이다; DEFAULT_TIMEOUT: 콜백 timeout 기본 10초 (설계). hook.message(text, look) 는 글과 look 의 icon·tone(문자열만)을 그대로 넘긴다 — 목록 검사는 core(hookRunner.merge)가 한다(표는 core 가 쥔다).

export fn killGroup(pid) {
  role: 프로세스 그룹을 SIGKILL — Windows 는 그룹이 없어 taskkill /T 트리. 이미 비었으면 조용히
}
export fn notJson(v, seen) -> Text? {
  role: JSON 으로 왕복하지 않는 값의 꼴 이름 — Map·Date·class 인스턴스·NaN·BigInt·함수·배열 안 undefined·순환. 객체 안의 undefined 는 키가 없는 것과 같아 받는다. 그 키는 저장하지 않고 경고(사용자 결정 2026-10-29)
}
export fn loadScript(js, vars, late) {
  role: 스크립트 하나를 vars(slcode.vars — 수집기에 넣는다)로 싣고 slcode.on() 등록(검사 전)을 모은다 — 던지면·옛 꼴이면 error, run() 이 없으면 warnings. 수집기는 import 가 끝나면 치운다(묶인 사본이 평가될 때 잡았다)
}
export fn checkRegs(raw, methods, matchers) {
  role: 모르는 이벤트·함수가 아닌 콜백은 빼고 사유, timeout 기본·failClosed 검사, matchers(hookApi.MATCHER_EVENTS) 밖 이벤트의 matcher 는 경고하고 무시 — worker 기동과 빌드의 목록 모드가 같이 쓴다
}
fn list(js, harness) {
  role: 목록 모드 — 그 하네스의 vars 로 실어 등록(콜백 빼고)을 stdout 에 JSON 한 줄, 스크립트가 띄운 타이머를 기다리지 않고 끝난다
}
type RawReg
val COLLECT
val STATE_LIMIT
export val DEFAULT_TIMEOUT
fn main(init, port) {
  role: exec 는 새 프로세스 그룹(detached)으로 띄우고 pgid 를 core 에 알린다 — 명령이 끝나면(출력 끝이 아니라 프로세스 종료 기준) 그룹에 남은 것을 종료하고 남은 출력을 50ms 만 더 받는다. setsid 로 그룹을 빠져나간 것은 남는다. 기본 cwd 는 세션 작업 폴더. timeout 을 주면 그룹째 끊는다
}
type Reg
type Result
type Info
type WorkerInit
type ToCore
type ToWorker
export fn checkCommand(cmds, onCalls) {
  role: COMMAND 파일의 등록 검사 (ticket slcode-agent-plugin-command) — slcode.command() 정확히 한 번, slcode.on() 없음, description(비지 않은 글)·run(함수) 필수, complete 함수·argumentHint 글·timeout 양수. 틀리면 error(add 거부 — 플러그인 적용 실패, 사용자 결정 2026-11-02), 모르는 칸은 warnings(새 판의 칸일 수 있다)
}
fn listCommand(js) {
  role: 명령 목록 모드(--list-command <묶은 COMMAND 파일>) — 실어 checkCommand 결과와 description·argumentHint·timeout·complete 유무를 JSON 한 줄로
}
fn deepFreeze(v) {
  role: complete 에 넘길 상태 사본을 깊게 얼린다 — complete 는 상태를 바꾸지 못한다
}
type CmdScript
type CmdInfo
type CompleteInfo
type CmdResult
type Item
// 명령: 같은 worker 가 WorkerInit.commands 의 COMMAND 파일도 싣는다(loadScript kind 'command' — 훅 스크립트의 command() 는 무시·경고). cmd 메시지면 run 을 부르고 성공이면 바뀐 키를, 던지면 상태를 저장한 값으로 되돌린다(훅과 달리 부분 적용이 없다).
// role 'complete' worker 는 COMMAND 파일만 싣고(훅 스크립트는 싣지 않는다) complete 메시지마다 core 가 준 상태 사본(deepFreeze)으로 부른다 — 오래 붙잡으면 core 가 그 worker 만 내린다.
