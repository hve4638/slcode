import { fetchTarball, placeDir, REGISTRY, untar } from './npmFetch'

role: esbuild 를 처음 필요할 때 받는다 (ticket slcode-plugin-split, 사용자 결정 2026-10-31 — slcode zip 에서도 뺀다) — js/ts 훅이 있는 플러그인을 묶을 때만(agentHooks). 그 플랫폼의 바이너리 패키지(@esbuild/<os>-<arch>, 약 4.7MB)와 JS 래퍼(esbuild, 34KB)를 받아 래퍼를 ESBUILD_BINARY_PATH 로 싣는다. 찾는 순서: 이 패키지에서 import 할 수 있는 같은 판 esbuild(개발 checkout — devDependencies) → 캐시(상태 폴더 agent-plugins/tools/esbuild-<판>-<플랫폼>, 사본들이 함께 쓴다) → 받기. 빌드가 동기라 받기는 같은 node 로 띄운 자식(--fetch)이 한다. 실패하면 사유를 <캐시>.failed 에 남기고 RETRY_MS 동안 다시 받지 않는다(오프라인에서 빌드마다 기다리지 않게). 상수 — ESBUILD_VERSION 0.28.2(devDependencies 와 같다); INTEGRITY: 래퍼와 linux·darwin·win32 의 x64·arm64; FETCH_MS 150초; RETRY_MS 5분.

export val ESBUILD_VERSION
val INTEGRITY
val FETCH_MS
val RETRY_MS
type Esbuild
export fn loadEsbuild(tools) -> Esbuild {
  role: esbuild — 못 받으면 사유를 던진다. 한 프로세스에서 한 번만 싣는다
}
fn loadCached(dir, plat) -> Esbuild
fn fetchTo(dir, plat)
