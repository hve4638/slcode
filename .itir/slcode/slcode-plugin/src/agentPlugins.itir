import { buildId, compat, HARNESSES, MANIFEST, parseAssignment, readManifest, resolveValues, sourceFiles, sourceHash, valuesString, userValues, walk, whenText, Harness, Manifest, Values } from './agentFormat'
import { BUILD_FILES, ensureBuild, Report } from './agentBuild'
import { acquireLock, releaseLock } from './lock'
import { defaultStateDir } from './paths'
import { ensureLauncher, PLUGIN_VERSION } from './launcher'
import { exportTo, refreshExport, unexport, withPartConditions, EXPORT_HARNESSES, ExportHarness, ExportReport, ExportResult } from './agentExport'
import { checkScripts } from './scriptCheck'
import { addonDir, assemble, dependentsOf, rootOf, AddonEntry, Addons, AddonState, Assembled } from './agentAddons'

role: 에이전트 플러그인의 상태 폴더와 명령 (ticket slcode-agent-plugin, 설계 ws docs/report/slcode-agent-plugin-survey.md) — <상태 폴더>/agent-plugins/(상태 폴더는 부른 쪽이 주고, 없으면 paths.defaultStateDir — slcode 와 같은 폴더, ticket slcode-plugin-split) {installed/<이름>(원본 복사본), config.json(설치 목록·플러그인 기본 설정·하네스별 마지막 빌드 — slcode 내부 파일, 임시 파일 + rename, 쓰는 명령은 config.lock), build/<식별자>, export(agentExport — 하네스별 마켓플레이스와 링크), data/<이름>(GPT 하네스·Codex 의 플러그인 데이터 — Codex 세션을 띄울 때 만든다, Claude 는 Claude 가 정하는 폴더)}. 설치는 원하는 상태를 적는 것이라 같은 원본을 몇 번 add 해도 결과가 같다 (superlite 플러그인이 데몬을 시작할 때마다 불러도 된다). 하네스 CLI 는 export(agentExport) 만 부른다 — export·remove·리빌드(add·set) 때. 설정 값은 manifest 기본값 < 플러그인 기본 설정(set) < 프로필(profiles.ts — 세션을 띄울 때 고른 프로필이 싣는 플러그인만, 그 프로필 층 값. load·reload·currentBuilds 의 profile 인자, 없으면 설치한 전부를 프로필 층 없이) < 세션(meta.agentPlugins). config.json 의 profiles 는 profiles.ts 가 쓴다 — locked·writeConfig 를 함께 쓴다. 세션에 싣기(Claude): 세션 폴더의 agent-plugins/<이름> 링크(Windows junction)가 그 세션이 쓰는 빌드의 플러그인 폴더를 가리키고 SDK 에는 링크 경로를 넘긴다 — 다시 싣기는 링크를 새 빌드로 바꾸고 SDK reloadPlugins() 를 부르는 것(링크를 바꾸고 reloadPlugins 하면 새 내용이 실린다, 2026-10-27 실측). 세션에 싣기(Codex, ticket slcode-agent-plugin-codex): 같은 agent-plugins/<이름> 링크가 Codex 빌드의 플러그인 폴더(build/<식별자>/codex)를 가리키지만 정리에서 지키는 용도일 뿐이고, 넘기는 경로는 빌드 폴더 그대로다(빌드 안의 경로 변수를 그 경로로 바꿨다). skill 폴더는 extra root, bin/ 은 프로세스 PATH 앞, MCP 는 app-server 인자, 지시문은 developerInstructions, manifest env 는 프로세스 env — 다시 싣기는 skill 만(설계): 기동 때의 빌드는 <이름> 링크로 남기고(MCP·bin 이 아직 쓴다) 새 빌드는 <이름>@skills 링크로 지킨다(@ 는 플러그인 이름에 올 수 없다). 정리(gcBuilds)는 config 의 마지막 빌드·세션 링크·export/ 아래 링크가 가리키지 않고 10분 넘은 빌드를 지운다 — 막 빌드하고 링크를 걸기 전의 틈을 남긴다. 상수 — STATE_FORMAT: 상태 폴더 형식 판 1 (ticket slcode-plugin-split, 사용자 2026-10-31 "메이저 안에서 최대한 호환, 메이저 뒤에도 하위호환 최대 유지") — 한 머신의 여러 slcode-plugin 사본(slcode 의 zip, superlite-for-agents 가 넣어 간 것)이 같은 상태 폴더를 쓴다. 형식은 칸 더하기로만 바꾸고 옛 사본이 읽지 못하게 바꿀 때만 올린다. writeConfig 는 이 판보다 높은 config.json 에 쓰지 않고 던진다(읽기는 한다). add 는 옛 항목의 모르는 칸을 남긴다

export val AGENT_DIR
export val SESSION_LINKS
type AgentPaths
type PluginEntry
type AgentConfig
type PluginLayer
export fn loadsPlugin(p, name) -> Boolean {
  role: 그 층(slcode 의 시작 프로필)이 그 플러그인을 싣는가 — 그 플러그인의 on, 정하지 않았으면 rest(나중에 설치한 플러그인은 rest 를 따른다)
}
export fn profileValues(p, name) -> Values {
  role: 그 플러그인의 층 part·옵션 값 (on 은 뺀다)
}
export val STATE_FORMAT
export fn refreshLauncher(ap, c) {
  role: export 한 플러그인이 있으면 훅 명령의 고정 런처(launcher.ensureLauncher)를 이 사본 기준으로 맞춘다 — CLI 명령마다·세션 시작 때(실패해도 세션은 뜬다). 사본의 node 가 바뀌어도 다음 실행에 고쳐진다
}
type AddResult
type PluginRow
type SessionHarness
type CodexLoad
type Loaded
type SessionPlugins
type SessionValues
type SessionParams
type Later
export fn agentPaths(stateDir) -> AgentPaths
export fn locked, writeConfig
export fn readConfig(ap) -> AgentConfig {
  role: 없거나 깨졌으면 빈 목록. plugins 의 키 순서가 설치 순서 — 지시문을 이 순서로 잇는다
}
export fn addPlugin(src, stateDir) -> AddResult {
  role: 애드온(manifest 의 addon)은 addons/<이름> 과 config 의 addons 칸에 넣고 베이스를 다시 빌드한다 — 베이스가 없거나 판 조건이 맞지 않거나 이름이 겹치면 던진다. 베이스를 갱신해 맞지 않게 된 애드온은 빌드에서만 빠지고 leftOut 에 사유가 남는다. manifest 를 읽고(없거나 깨지면 던진다 — 설치 거부) 내용 해시가 같고 설치본이 있으면 아무것도 하지 않는다(changed false). 아니면 sourceFiles 를 installed/<이름> 에 통째로 바꿔 넣고, 호환 등급을 매기고, 옛 판의 기본 설정 중 이 판에 맞는 값만 남겨 기본 설정으로 세션 하네스(Claude·Codex)마다 빌드해 builds 에 적는다(결과의 build 는 Claude 빌드). export 한 하네스가 있으면 export 를 새 빌드로(refreshExport — 실패는 결과 exports 의 notes), export 목록은 새 판에도 이어진다
}
export fn removePlugin(name, stateDir, env, cascade) {
  role: 의존하는 애드온이 있으면 cascade 없이는 던지고 cascade 면 함께 지운다. 애드온 이름이면 그것만 지우고 베이스를 다시 빌드한다. 지운 애드온의 part·옵션 값은 프로필에서도 지운다(기본 설정 값은 애드온 칸에 있어 함께 사라진다). 설치본·설정 항목·export 를 지우고(export 를 먼저 해제 — 링크가 사라진 빌드를 가리키면 하네스가 오류를 낸다), 링크가 가리키지 않는 그 플러그인의 빌드도 바로 지운다. 없으면 removed false 로 성공
}
export fn exportPlugin(name, harnesses, remove, stateDir, env) -> ExportResult[] {
  role: slcode plugin export — 대상은 claude·codex(그 밖은 거부). remove 면 export 한 하네스만 해제(unexport), 아니면 exportTo 하고 성공한 하네스만 config 의 exports 에 적는다(실패면 던진다). 설정 값은 플러그인 기본 설정
}
export fn setPlugin(name, assignments, stateDir) {
  role: 플러그인 기본 설정에서 part 켜고 끄기·옵션 값 — 하나라도 틀리면 아무것도 바꾸지 않는다. 새 기본 설정으로 세션 하네스마다 빌드하고(결과의 build 는 Claude 빌드) export 를 새 빌드로
}
export fn listPlugins(stateDir) -> PluginRow[] {
  role: 설치 순서로 — 판, 호환 등급과 하네스별 빠지는 것, part(필수·켬·조건 when 의 글·조건 when part 의 대상 needs — 켬은 사용자 설정이고 조건은 세션마다 따로 본다. needs 는 관리 화면이 대상이 꺼진 part 를 비활성으로 보이는 데 쓴다)·옵션 값(기본 설정 기준), 하네스별 마지막 빌드의 report.json, export 한 하네스와 그 export 판의 report.json(exported — 빠지거나 다르게 도는 것, ticket slcode-agent-plugin-ui)
}
export fn orphanAddons(stateDir) {
  role: 베이스가 없어 실리지 않는 애드온 — 옛 사본이 베이스를 지웠을 때 남는다. 베이스를 다시 add 하면 돌아온다
}
export fn pluginManifest(ap, c, name) -> Manifest {
  role: 애드온까지 합친 manifest — slcode 프로필이 값을 검사할 때 쓴다
}
export fn scriptWarnings(name, build, stateDir) -> String[] {
  role: Claude 빌드의 js/ts 훅 보고 줄 — 묶지 못한 것(failed)·고칠 것(warning)과 하네스별 tsc 검사 경고(checkScripts). CLI add·set 이 stderr 에, 시작 화면의 관리 화면(plugins.check)이 플러그인 칸에 보인다 (ticket slcode-agent-plugin-ui 에서 cli 의 scriptReport 를 옮김). 경고일 뿐 빌드는 그대로
}
export fn claudeDataDir(name, env) -> Path {
  role: Claude 의 플러그인 데이터 폴더 <CLAUDE_CONFIG_DIR 또는 ~/.claude>/plugins/data/<이름>-inline — 지시문의 ${CLAUDE_PLUGIN_DATA}. 빌드가 바꾸지 않는다(훅 명령 문자열과 Claude 가 주는 env 가 다른 폴더를 가리키게 된다)
}
export fn loadSessionPlugins(sessionDir, env, session, stateDir, harness, params) -> SessionPlugins {
  role: 세션을 띄울 때 — 지난 링크를 지우고, 프로필이 싣는(loadsPlugin) 플러그인마다 기본 설정 < 프로필 < 세션 값과 세션 인자 params·세션 env(part 조건 when, ticket slcode-agent-plugin-part-when, -part-when-part. env 는 받은 값 그대로이고 manifest env 는 조건에 쓰지 않는다 — part 가 자기 조건을 스스로 켤 수 있기 때문)로 그 하네스(기본 claude)의 빌드를 만들고(있으면 다시 쓴다) 링크를 건다. Codex 면 plugins 는 비우고 codex {roots(skill extra root), bin(PATH 앞), args(app-server 인자)} 를 설치 순서로 모으고, 지시문은 빌드가 바꾼 그대로 잇고, 데이터 폴더를 만든다. Claude 면 지시문의 ${CLAUDE_PLUGIN_ROOT} 는 링크 경로, ${CLAUDE_PLUGIN_DATA} 는 claudeDataDir 로 바꿔 설치 순서로 잇고, env 는 합치고, session.json 은 뒤의 플러그인이 이긴다. 싣지 못한 플러그인은 notes 에 사유만 — 세션은 오류 없이 뜬다
}
export fn reloadSessionPlugins(sessionDir, loaded, env, session, stateDir, harness, params) {
  role: 다시 싣기 — 실은 플러그인의 링크를 지금 설정(params·env 는 기동 때와 같은 값)의 빌드로 바꾼다, 지운 플러그인·지금 프로필이 싣지 않는 플러그인은 링크를 뗀다(removed). later 는 이 세션에 반영되지 않아 새 세션부터인 것: 지시문·env·session.json·(Codex)MCP 인자·bin 내용이 기동 때와 달라진 플러그인, 세션 뒤에 설치해 프로필이 싣는 플러그인(installed). Codex 는 <이름> 링크(기동 때 빌드)를 두고 새 빌드가 다르면 <이름>@skills 링크를 걸고(같으면 뗀다), roots 로 새 extra root 들을 낸다 — Codex 값엔 빌드 폴더 경로가 박혀 있어 견줄 때는 그 경로를 ${CLAUDE_PLUGIN_ROOT} 로 되돌린다(경로만 다른 같은 내용은 later 가 아니다). loaded 의 codex 는 기동 때 값(root·bin·args)에 skills 만 새 것. loaded 의 지시문·env·session.json 은 기동 때 값으로 둔다 — 다음 비교의 기준. SDK reloadPlugins() 는 부른 쪽(core)이 한다
}
export fn currentBuilds(session, stateDir, harness, params, env) {
  role: 지금 설정(프로필이 싣는 플러그인만, 프로필 층 포함, 세션 인자 params·세션 env 로 part 조건)으로 그 하네스(기본 claude)의 빌드를 만들면 나올 식별자(빌드하지 않는다) — 세션이 실은 것과 다르면 다시 실을 것이 있다. 설치본이 깨졌으면 null
}
export fn unlinkSessionPlugins(sessionDir) {
  role: 세션이 닫힐 때 링크를 떼어 그 빌드를 정리 대상으로
}
export fn gcBuilds(stateDir, graceMs, removed) -> String[] {
  role: 지운 빌드 식별자. removed(방금 지운 플러그인 이름)면 그 플러그인의 빌드는 유예 없이 — 새 세션이 더는 그것을 빌드하지 않는다(세션·export 링크가 가리키면 남긴다). 남기는 것 — config 의 하네스별 마지막 빌드, 모든 세션 폴더의 링크, export/ 아래 링크가 가리키는 빌드, graceMs 안에 만들거나 다시 쓴 빌드. add·remove·set 뒤에 부른다
}
fn defaultBuild(ap, name, e) {
  role: 기본 설정으로 세션 하네스마다 빌드해 e.builds 에 적고 Claude 빌드를 돌려준다
}
fn prune(v, m) -> Values {
  role: 옛 판의 설정 중 이 판에 있는 키, 꼴이 맞는 값만 (필수 part 값은 버린다)
}
fn plan(ap, name, e, link, layers, env, harness) {
  role: 플러그인 하나의 지금 빌드와 세션에 넘길 값 — Codex 면 codex(root·skills·bin·bin 내용 해시·args)와 데이터 폴더
}
fn relink(link, target) {
  role: 옆에 만든 링크를 rename — 바꾸는 사이 링크가 없는 순간이 없다
}
fn checkCommands(src, m, tools) {
  role: add 가 원본을 들이기 전에 — agentFormat.commandErrors 와 COMMAND 파일 꼴(임시 폴더에 묶어 한 번 싣는다)을 모든 part 에서 본다. 틀리면 던진다(설치하지 않는다, 사용자 결정 2026-11-02). esbuild 를 받지 못하면 꼴 검사는 건너뛴다(빌드가 그 명령을 빼고 다음 add 때 다시 받아 본다). scriptWarnings 는 명령의 failed·warnings 와 claude 표 tsc 검사도 낸다
}
