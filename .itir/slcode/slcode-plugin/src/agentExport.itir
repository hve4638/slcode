import { readManifest, resolveValues, userValues, whenText, Manifest } from './agentFormat'
import { BUILD_FILES, buildCodex, Report } from './agentBuild'
import { readScripts } from './agentHooks'
import { AgentPaths, PluginEntry } from './agentPlugins'
import { ensureLauncher } from './launcher'

role: 에이전트 플러그인 export (ticket slcode-agent-plugin-export, 설계 ws docs/report/slcode-agent-plugin-survey.md "export", 착수 결정 TICKET.md 2026-10-30·31) — 플러그인 기본 설정의 빌드를 하네스의 사용자 설정에 등록해 터미널에서 직접 띄운 claude·codex 에도 싣는다(프로필 고르기는 미정). 사용자 상태(~/.claude·~/.codex)에 쓰는 곳은 여기뿐이고 하네스 CLI(env 의 PATH)로만 쓴다. pi export 는 GPT 하네스 ticket. 마켓플레이스 이름은 두 하네스 모두 slcode — export/claude/(.claude-plugin/marketplace.json, Claude 디렉터리 마켓플레이스)·export/codex/(.agents/plugins/marketplace.json), 플러그인마다 <이름> 링크(Windows junction)가 build/<식별자>/export/<하네스>/<이름> 을 가리킨다. Claude 는 링크 경로에서 바로 읽으므로(readFromFolder, 실측) 리빌드는 링크만 바꾼다 — 열린 세션은 /reload-plugins, 지시문은 새 세션부터. Codex 는 `codex plugin add` 때 캐시(~/.codex/plugins/cache/slcode/<이름>/<판>)에 복사하므로 리빌드 때 다시 add 해 복사본을 다시 쓴다(0.165 실측: 같은 판이어도 다시 복사, 판이 바뀌면 옛 판 폴더를 지운다). export 판은 세션 빌드에 한 단계를 더한다 — 지시문은 SessionStart 훅의 additionalContext 로(hooks/slcode-instructions.json 을 cat 하는 훅을 SessionStart 맨 앞에. Codex 는 additionalContextLimit 0 으로 기본 약 2500 토큰 한도를 푼다). Codex 훅 신뢰는 정의 해시와 플러그인 내용 해시 둘이라(hooks.state 의 trusted_hash·trusted_content_hash, 0.165 실측) 내용이 바뀌는 리빌드마다 다시 묻는다 — slcode 는 신뢰 기록을 쓰지 않고 사용자가 codex 시작 때의 훅 검토에서 Trust all 을 고른다(사용자 결정 2026-10-31, Codex 는 중간 단계라 우회를 두지 않는다), 옮길 수 없는 것은 report.json 의 excluded 에. js/ts 훅(slcode-agent-plugin-script-portable): Claude 빌드의 묶은 스크립트를 export 판의 slcode-hooks/ 에 복사하고, 그것을 돌리는 command 항목(agentHooks.exportHookEntries — 플러그인·이벤트마다 `<상태 폴더>/agent-plugins/bin/hook <harness> <폴더> <이벤트>` — 고정 런처(launcher.ts)가 사본의 node·hookMain.js 로 넘긴다, ticket slcode-plugin-split)을 hooks.json 에 더한다(Codex 판도 Claude 빌드의 것 — 묶은 파일은 하네스들이 같이 쓴다).

export val EXPORT_HARNESSES
export val MARKETPLACE
type ExportHarness
type ExportReport
type ExportResult
export fn exportLink(ap, h, name) -> Path
fn addScriptHooks(cbuild, plugin, h, hooks, root?) -> ScriptEntry[] {
  role: 빌드 cbuild 의 scripts/·scripts.json 을 plugin/slcode-hooks/ 로 복사하고 exportHookEntries 항목을 hooks 의 이벤트 끝에 더한다. root 가 있으면 명령의 "${CLAUDE_PLUGIN_ROOT}" 자리를 그 경로로(셸 "…" 안 이스케이프)
}
export fn withPartConditions(report, m, e) -> ExportReport {
  role: 켜 둔 조건 part(when) — export 판에는 세션 인자가 없어 기본 빌드에서 이미 빠졌다 — 를 excluded 에 '<part>: part condition <whenText> (slcode session params only)' 로 붙인다 (ticket slcode-agent-plugin-part-when, 사용자 결정 2026-11-02). 조건으로 꺼진 빌드와 사용자가 끈 빌드는 식별자가 같아 export 판 report.json 을 함께 쓰므로 저장하지 않고 읽을 때마다(exportBuild·listPlugins) 붙인다
}
export fn exportBuild(ap, name, e, h, env) {
  role: 그 하네스의 export 판 build/<e.builds[h]>/export/<하네스>/{<이름>/, report.json} — 있으면 다시 쓰고, 없으면 옆에 만든 뒤 rename(먼저 놓인 것을 쓴다). Claude: 세션 빌드의 플러그인 폴더를 복사하고, 지시문의 ${CLAUDE_PLUGIN_ROOT} 는 export 링크, ${CLAUDE_PLUGIN_DATA} 는 Claude 가 이 출처에 주는 <설정 폴더>/plugins/data/<이름>-slcode 로 바꾼다. excluded: 빌드의 lost·dropped, session.json(플러그인으로 옮길 수 없다), env. Codex: 경로 변수를 export 링크·data/<이름> 으로 바꿔 buildCodex 로 다시 빌드하고 .codex-plugin/plugin.json(manifest 이름·판)·.mcp.json(codex-mcp.json)·hooks/hooks.json(codex-hooks.json — Codex 가 받는 이벤트의 command 훅, ${slcode.vars.harness}=codex) 을 둔다. js/ts 훅 명령의 플러그인 폴더는 export 링크. excluded: 빌드의 lost 중 hooks.json 통째 대신 못 싣는 훅 항목(없는 이벤트 — js/ts 항목 줄은 빼고 agentHooks.codexGaps 줄을 넣는다), bin/(Codex 는 플러그인 bin 을 PATH 에 넣지 않는다), env 돌려주는 report 는 withPartConditions 를 거친다
}
export fn exportTo(ap, name, e, h, names, env) -> ExportResult {
  role: export 판을 만들고 링크를 걸고 마켓플레이스 파일(names — 그 하네스에 export 한 플러그인)을 쓴 뒤 하네스에 등록한다 — claude: plugin marketplace add <export/claude> + plugin install <이름>@slcode, codex: plugin marketplace add <export/codex> + plugin add <이름>@slcode(둘 다 이미 있으면 하네스가 아무것도 하지 않는다, 실측). 등록이 실패하면 링크·마켓플레이스를 되돌리고 던진다
}
export fn refreshExport(ap, name, e, h, env) -> ExportResult {
  role: 리빌드 뒤 — export 판을 만들고 링크를 바꾼다. Codex 는 plugin add 로 캐시 복사본을 다시 쓴다. 실패는 notes 로(리빌드를 막지 않는다)
}
export fn unexport(ap, name, h, names, env) -> ExportResult {
  role: 하네스에서 지우고(claude plugin uninstall·codex plugin remove — 실패는 notes, slcode 쪽은 늘 지운다), 링크를 떼고, 마켓플레이스에서 뺀다. 남은 플러그인(names)이 없으면 하네스의 marketplace remove 와 export/<하네스> 폴더까지 — 사용자 설정에 slcode 흔적을 남기지 않는다(Claude 는 캐시 복사본에 .orphaned_at 를 붙여 스스로 정리한다)
}
fn claudeExportData(name, env) -> Path
fn writeMarketplace(ap, h, names) {
  role: 임시 파일 + rename
}
fn relink(link, target)
fn cli(h, args, env) -> Text {
  role: 하네스 CLI 를 부른다. 없으면 "CLI not found on PATH", 실패면 그 출력(WARNING 줄 제외)으로 던진다
}
fn register(ap, h, name, env)
