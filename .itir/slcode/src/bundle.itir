import { EventLog, SessionMeta } from './eventLog'
import { cwdSlug } from './paths'
import { findVendorSession, forkClaude, claudeHome, codexHome } from './vendor'
import { PROMPTS_DIR, checkPromptName } from './promptLibrary'

role: 세션 파일 (ticket slcode-session-bundle, 사용자 결정 2026-11-24~25 — ws docs/ticket/slcode-session-bundle/TICKET.md "사용자 결정") — 개발 서버를 다른 머신·다른 폴더로 옮길 때 slcode 세션 하나를 화면 기록과 모델 기억까지 그대로 옮긴다. 파일 하나는 gzip 한 JSON(.slsession, node:zlib — 새 의존성 없음): {format 'slcode.session', version 1, exportedAt, meta(SessionMeta), events(LoggedEvent 배열), prompt(쓰는 system prompt 판 {name, version, data, description} 또는 null), vendor({sessionId, files: [{path, data(base64)}]} 또는 null — 턴이 없어 벤더 세션이 없으면 null)}. 담는 것은 slcode 기록과 벤더 transcript(Claude 는 projects/<슬러그>/ 안의 <id>.jsonl 과 같은 이름의 폴더 — 서브에이전트 기록·긴 도구 출력, path 는 그 projects 폴더 기준. Codex 는 rollout 하나, path 는 sessions 폴더 기준)와 prompt 판. inspect 기록·코드 되돌리기 스냅숏(file-history)·팀원은 담지 않는다. 담은 기록의 내용은 고치지 않는다 — transcript 의 cwd 칸·대화 본문의 경로는 과거 실행 위치의 기록으로 남고, 실행 위치는 들여온 폴더(meta.cwd)다. 벤더 판이 달라 읽지 못하면 벤더 오류를 그대로 보인다(형식 변환 없음). 벤더 설정 폴더는 이 프로세스 env 의 CLAUDE_CONFIG_DIR·CODEX_HOME(없으면 HOME 아래 기본)

export fn exportBundle(log, stateDir, file) -> Exported {
  role: 세션 하나를 file 에 쓴다 — 'wx' 로 열어 있는 파일은 덮어쓰지 않고(EEXIST), 0600. vendorSessionId 가 있는데 벤더 기록을 찾지 못하면 오류(대화 없이 내보내지 않는다). meta.prompt 가 있으면 그 판 파일(prompts/<이름>/v<n>.json)과 설명(prompt.json)을 담고 없으면 null 쓰는 곳은 `slcode export <s> <파일>`(cli)과 화면의 내보내기 모달(serve.export — 고른 폴더·이름).
}
export fn importBundle(file, sessionsDir, stateDir, cwd, opts) -> EventLog {
  role: 파일을 읽어 cwd 를 실행 위치로 하는 새 세션(닫힌 채)을 만든다 — 늘 새 slcode 세션 id(randomUUID 앞 8자)와 새 벤더 세션: 원본 transcript 를 벤더 설정 폴더의 제자리(Claude 는 projects/<cwd 슬러그>/, Codex 는 sessions/ 아래 원래 날짜 폴더)에 놓고(같은 원본이 이미 있으면 그대로 쓴다 — 같은 파일을 두 번 들여올 때) `import --from` 처럼 복제한다. Claude 는 forkClaude(원본 id, cwd)로 새 id 를 받고 복제본 줄마다의 forkedFrom.messageUuid 로 옛 uuid → 새 uuid 를 만들어 slcode 기록의 turn.end userUuid·uuid 와 session.imported uuid 를 바꾼다(되돌리기·fork 지점이 복제본을 가리키게, 못 찾는 uuid 는 null). Codex 는 meta.forkFrom 만 두고 첫 기동이 thread/fork(turn id 는 그대로라 기록을 고치지 않는다). 새 meta 는 원래 meta 의 설정(벤더·제목·권한 모드·raw·모델·effort·inspect·에이전트 플러그인 값·custom provider id·프로필·prompt·env·세션 인자·noTeam·updatedAt·createdAt)을 잇고 closedAt 은 들여온 때(continue·resume 목록의 맨 앞), opts.title·mode 가 있으면 덮는다. 이 머신에 없는 관계(parent·team·agent·worktree)와 pid·fromStart·forkAt 은 뺀다. 프로바이더 설정·키(providers.json)는 파일에 담지 않는다 — 이 머신에 같은 id 가 없으면 core 가 그 세션을 열지 않고 다시 추가하라고 알린다. movedFrom {원래 id, 원래 cwd, exportedAt}. prompt 판은 이 머신에 그 이름·판이 없을 때만 놓는다(설명도 없을 때만). format·version 이 다르면 아무것도 쓰지 않고 오류. 복제가 실패하면 이번에 놓은 벤더 파일과 만든 세션을 지운다
}
type Bundle
type Exported
