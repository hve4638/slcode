import { connectSession, PKG } from './client'
import { spawnCore, undiscardable } from './live'
import { EventLog } from './eventLog'
import { startServer } from './startPage'
import { corePaths } from './paths'
import { CoreOptions } from './core'
import { SessionInfo } from './protocol'

role: 웹 모드 진입 프로세스 — 터미널에서 친 slcode new·resume·continue (ticket slcode-core-serve-split 2단계, 설계 ws docs/report/slcode-core-serve-split.md "serve 교체", 사용자 2026-10-19). core 를 detached 로 띄우고(spawnCore) 그 소유자(core.own {pid})가 된다. TCP 포트는 이 프로세스가 끝까지 쥐고(pauseOnConnect — 읽지 않는다) 들어온 연결을 지금의 serve 자식(dist/serveMain.js 를 fork, execArgv 없이)에 IPC 로 넘긴다; listen 핸들을 넘기지 않는 것은 핸들을 쥔 이 프로세스도 연결을 받기 때문 — 포트가 비는 순간도 받을 쪽이 둘인 순간도 없다. serve 자식이 없는 틈의 연결은 끊는다(화면이 다시 붙는다). 교체: 자식이 {type:'restart'} 를 보내면 같은 설치 폴더의 dist/serveMain.js(디스크의 새 코드)로 새 자식을 띄워 ready 를 기다리고(READY_MS 15초), 연결을 그쪽으로 돌린 뒤 요청한 자식에 restart-result {ok} 와 stop 을 보낸다. 못 뜨면 restart-result {ok:false, reason} — 옛 자식이 그대로 일한다. 교체가 겹치면 거절. 크래시: 지금의 자식이 교체 중이 아닐 때 끝나면 한 번 다시 띄우고, 그 뒤 CRASH_WINDOW_MS(1분) 안에 또 끝나거나 다시 띄우지 못하면 세션을 닫는다(사용자 2026-10-19 — 세션이 살아 있는데 화면 때문에 닫지 않되, 반복 크래시로 계속 뜨지 않게). 수명: close(Ctrl-C·SIGTERM·SIGHUP)는 session.close 를 보내고 core 가 끝나기를(최대 15초) 기다린다; core 가 끝나면 포트를 닫고 done — serve 자식은 core 연결이 끊겨 스스로 끝난다. 포트를 열지 못하거나 첫 serve 가 뜨지 못하면 세션을 닫고 던진다. 이 프로세스는 교체되지 않으므로 serve 자식과의 IPC 는 늘리기만 한다. core 교체(3단계): 소유권을 core.own {pid, follows} 로 잡아 따라 붙을 수 있음을 알린다 — core.replaced 를 받은 뒤 제어 연결이 끊기면 세션을 끝내지 않고 같은 소켓에 다시 붙어(connectSession 이 교체 표시를 보고 기다린다) core.own 을 다시 보낸다; 다시 붙지 못하면 core 가 끝난 것과 같다. 교체를 시작하는 것(core.retire)은 이 프로세스가 아니라 새 코드의 serve 자식이다 — 이 프로세스는 뜰 때의 옛 코드로 남는다.

val READY_MS
val CRASH_WINDOW_MS
export fn runEntry(opts) -> EntryHandle {
  role: 포트 listen → (opts.choose 면 프로필 고르기) → core 띄우기·소유 → 첫 serve 자식 ready → {url(serve 가 serve.register 로 받은 것), sock, session, close, done}. 프로필 고르기(ticket slcode-session-profile, 사용자 2026-10-30): opts.choose 가 있으면(동사 없는 slcode 의 시작 화면) core 를 띄우기 전에 그 포트의 연결을 startPage.startServer 에 넘겨 시작 화면을 서빙하고 주소를 choose(url)로 알린다. 고른 프로필로 새 core 를, 또는 고른 꺼진 세션을 이어서(새 세션용 값은 넘기지 않는다) 띄우고, 고른 뒤 첫 serve 가 뜰 때까지 들어온 연결은 쥐고 있다가(held) 넘긴다 — 화면이 새로 고치면 대화 화면이 된다. 고르기 전엔 세션이 없어 Ctrl-C 는 그냥 끝난다 고른 새 세션은 fromStart. 시작 화면으로 돌아가기(start.back — serve 가 IPC {type:'back'}): undiscardable 이면 back-result 로 거절, 아니면 받아들이고 세션을 닫은 뒤(close 가 core 가 끝나기를 기다린 다음) 세션 기록을 지우고 끝난다 — EntryHandle.back 이 true, 부른 쪽(cli startWeb)이 같은 포트에 시작 화면을 다시 연다.
}
type EntryOptions
type EntryHandle
