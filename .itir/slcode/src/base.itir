import { ApprovalRequest, Attachment, CoreEvent, LoggedEvent, SessionInfo } from './protocol'
import { EventLog } from './eventLog'

role: 벤더 어댑터의 공통 뼈대 (ticket agent-core-codex, 2026-09-30) — 세션 id·EventLog·state·seq·구독자·raw 스위치와 emit/info/onEvent/since 를 들고, 벤더별 동작(send·approve·interrupt·close·models·setModel·setEffort·setMode·commands·limits·context·mcp·reconnectMcp·rewind)은 추상. serve.ts 는 이 표면만 본다 — ClaudeSession(session.ts)·CodexSession(codex.ts) 이 구현한다. CLAUDE_EFFORTS 는 Claude 의 effort 이름(SDK EffortLevel)을 두는 한 곳 — cli.ts checkNew 가 --effort 오타를 거절하는 데, ClaudeSession.models 가 supportedEffortLevels 를 주지 않는 모델의 efforts 로 쓴다. 플러그인 main.js 는 slcode 를 import 하지 못해 같은 목록을 따로 둔다 (ticket slcode-vendor-model-picker)

export val CLAUDE_EFFORTS
type ModelsResult
type Limits
type ContextUsage
type Command
type ApproveOpts
export fn sessionEnv(pairs) -> Record {
  role: 새 세션 env(--env, ticket slcode-new-session-env, 사용자 결정 2026-11-01)를 NAME=VALUE 목록에서 이름→값으로. 값 하나에 여러 쌍을 줄바꿈으로 나눠도 된다 — superlite 동사 인자는 같은 option 을 여러 번 주면 마지막 값만 남기므로 slcode.new --env 는 줄바꿈으로 받는다(빈 줄은 건너뛴다). 이름은 [A-Za-z_][A-Za-z0-9_]*, SLCODE_ 로 시작하면 거절(slcode 가 넣는 값을 덮지 못한다), = 가 없으면 거절 — 사유를 담은 Error. 같은 이름은 뒤의 것. cli.ts 가 쓰고 core 는 sessionEnvError 로 다시 본다. 플러그인 main.js 는 같은 규칙을 따로 둔다
}
export fn sessionParams(pairs) -> Record {
  role: 새 세션 인자(--param·-P, ticket slcode-agent-plugin-part-when, 사용자 결정 2026-11-02)를 NAME=VALUE 목록에서 이름→값으로 — 줄바꿈으로 나눈 여러 쌍·빈 줄·같은 이름은 sessionEnv 와 같다. 이름은 [A-Za-z_][A-Za-z0-9_]*(SLCODE_PARAM_<이름> env 가 된다), 대소문자만 다른 두 이름은 거절(Windows env 는 대소문자를 가리지 않는다), = 가 없으면 거절. 플러그인 main.js 는 같은 규칙을 따로 둔다
}
export fn sessionParamsError(params) -> Text? {
  role: 세션 인자 묶음이 받을 수 없으면 사유 — 이름 글자·대소문자 겹침. sessionParams·core 가 같은 규칙으로 본다
}
export val PARAM_ENV
export fn sessionEnvError(name) -> Text? {
  role: 새 세션 env 이름이 받을 수 없으면 사유, 받으면 null — sessionEnv·core 가 같은 규칙으로 본다
}
export fn effortMisfit(r, effort) -> Text[]? {
  role: effort 가 지금 모델에 없으면 그 모델의 efforts, 맞거나 알 수 없으면(목록에서 지금 모델을 못 찾음·efforts 가 없는 모델) null. 지금 모델 찾기는 화면(web/app.js)과 같다 — value 가 같거나 [..] 를 뗀 resolvedModel 이 같은 것, 지금 모델을 모르면 default. 벤더 기동 때 meta.effort 가 있으면 어댑터가 이것으로 보고, 맞지 않으면 notice 로 알린 뒤 effort 를 비워 벤더 기본으로 돈다 (ticket slcode-new-effort-prompt, 사용자 결정 2026-10-23)
}
export class AgentSession {
  role: 추상. emit 은 session.state 면 state 를 갱신하고 raw 가 켜져 있으면 벤더 원문을 실어 로그에 남기며 구독자에게 낸다
  export fn info() -> SessionInfo {
    role: meta + state + live + seq
  }
  export fn onEvent(fn) {
    role: 구독 — 해지 함수를 돌려준다
  }
  export fn since(seq) -> LoggedEvent[] {
    role: EventLog.since
  }
  export fn notice(message) {
    role: 벤더가 아니라 core 가 알리는 일을 error 이벤트로 남긴다 (inspect 를 켜지 못함·껐음 등)
  }
  export fn opened(source) {
    role: core 가 이 세션을 열었다는 표지를 session.opened {source} 이벤트로 남긴다 (기동마다, ticket slcode-session-open-notice)
  }
}
