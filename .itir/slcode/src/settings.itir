import { FILES, Settings, SettingsKind, SettingsPatch } from './protocol'

role: 화면 설정 — 테마·context 경고 (ticket slcode-web-settings, 사용자 확정 2026-10-16)·새 세션 inspect (ticket slcode-inspect-default-on, 2026-10-19 — 그 입구에서 여는 새 Claude 세션의 시작값, 기본 끔, 꼴이 틀리면 base 값). 상태 폴더에 입구(SettingsKind)마다 파일 하나 — $SLCODE_DIR/settings-web.json(브라우저로 연 slcode)과 settings-superlite.json(superlite 안의 slcode 탭). 두 벌은 완전히 따로다(사용자 결정 2026-10-16 — 한쪽에서 바꿔도 다른 쪽은 그대로, 기본값은 같다). 같은 입구끼리는 같은 상태 폴더를 쓰는 모든 serve(떠 있는 세션·새 세션)가 같이 읽고 쓴다. 브라우저 localStorage 엔 두지 않는다 (sandbox 카드에서 SecurityError, 브라우저·카드마다 갈라진다). 테마 id 의 목록은 웹(web/settings.js)이 정한다 — 여기서는 꼴만 맞추고 모르는 id 는 웹이 'system' 으로 읽는다. 기본값의 context 경계 30·50 은 사용자 결정 (2026-10-16).

export val DEFAULT_SETTINGS
export fn normalizeSettings(v, base) -> Settings {
  role: 꼴이 맞는 값만 남기고 나머지는 base 의 값 — id 는 1~64자 문자열, 두 경계는 0~100 으로 자르고 반올림한 정수, yellow ≤ red 로 순서를 맞춘다
}
export fn readSettings(dir, kind) -> Settings {
  role: 없거나 읽을 수 없으면 기본값
}
export fn writeSettings(dir, kind, patch) -> Settings {
  role: 지금 파일에 patch 를 겹친다 (context 는 항목별로, 꼴이 틀린 항목은 지금 값). 임시 파일 + rename — 감시하는 다른 serve 가 반쯤 쓴 파일을 읽지 않게
}
export fn watchSettings(dir, kind, onChange, pollMs) {
  role: 그 입구의 파일이 바뀌면(어느 프로세스가 썼든, 손으로 고쳤든) 새 값으로 onChange, 내용이 같으면 부르지 않는다. 파일이 아니라 폴더를 본다 — rename 으로 바뀐 파일은 파일 감시가 놓친다. 감시를 못 걸거나 감시가 오류를 내면 pollMs(기본 1초)마다 파일 상태를 본다 — inotify 감시 한도는 머신의 다른 프로그램과 나눠 쓰고 바닥나면 ENOSPC (2026-10-16 실측). 돌려주는 함수로 멈춘다
}
fn fileOf(dir, kind)
