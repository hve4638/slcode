import { CoreEventBody, Usage, Vendor } from './protocol'
import { EventLog, unrewound } from './eventLog'
import { summarize } from './session'
import { toolOf, toolResult, collabTask, isAuthError, readThread } from './codex'
import { findVendorSession } from './vendor'

role: 벤더 기록 → slcode 이벤트 (ticket slcode-import-history, 사용자 결정 2026-10-15) — `slcode import` 가 Claude Code·Codex 에서 하던 대화를 실시간 것과 같은 이벤트로 events.jsonl 에 옮겨 써서 화면에 보인다. Claude 는 Agent SDK getSessionMessages(parentUuid 로 살아 있는 줄기를 고르고 rewind 곁가지·sidechain·meta 를 뺀다; 마지막 compact 뒤만 온다 — Claude Code 가 resume 때 싣는 범위라 그 앞은 가져오지 않는다), Codex 는 app-server thread/read 의 turns. 벤더 기록은 공개 계약이 아니라 모르는 항목은 건너뛴다. 큰 세션의 메모리 상한은 eventLog 와 같은 남긴 엣지

export fn claudeEvents(msgs) -> TimedEvent[] {
  role: 턴 = 사용자 프롬프트부터 다음 프롬프트 앞까지. 프롬프트는 turn.start(슬래시 명령은 `/이름 인자`, `!` 셸은 `! 명령`이고 그 출력은 코드 블록 text.delta, 이미지는 첨부 이름만), assistant 의 text·thinking·tool_use 는 text.delta·thinking.delta·tool.start, tool_result 는 tool.end, compact 요약은 context.compacted. 로컬 명령의 기록과 출력(isCompletedLocalCommand)·meta 는 건너뛴다. `[Request interrupted by user…]` 는 그 턴을 interrupted 로. 백그라운드 작업 알림(origin task-notification)과 프롬프트 앞에 놓인 항목은 turn.start 없는 턴 — 실시간에도 사용자 말풍선 없이 온다. turn.end 는 userUuid(프롬프트 uuid)·uuid(턴의 마지막 항목 — 대화 되돌리기의 유지 지점)·durationMs(타임스탬프 차)·usage(API 메시지 id 마다 마지막 값의 합)를 들고 costUsd 는 null. API 오류·인증 실패의 synthetic 문구는 답변이 아니라 turn.end 실패(ok false, error 는 그 문구, errorKind 는 authentication_failed 면 'auth') — 실시간 session.ts 와 같다(ticket slcode-auth-error-shown-as-answer). 그 표지(isApiErrorMessage·error 칸)는 SDK 가 넘기지 않아 pullHistory 가 기록 파일에서 그 줄만 골라 읽어 붙인다
}
export fn codexEvents(turns) -> TimedEvent[] {
  role: Turn 하나 = turn.start(첫 userMessage, 없으면 생략 — 압축만 한 턴) … turn.end(status, durationMs, uuid 는 turn id). 항목은 codex.ts 의 실시간 매핑대로 — toolOf 항목은 tool.start+tool.end, agentMessage 는 text.delta, reasoning 은 요약(없으면 본문)을 thinking.delta, contextCompaction 은 context.compacted, collabAgentToolCall 은 task started+ended. failed 턴은 turn.error 의 문구와 errorKind(codexErrorInfo 가 인증 실패면 'auth'). inProgress 턴은 빼고 다음 import 로 미룬다. Turn 엔 사용량이 없어 usage null
}
export fn pullHistory(log, from, mark) -> Pulled? {
  role: 벤더 세션 from 의 기록에서 로그가 모르는 뒤쪽을 이벤트로 붙이고 session.imported 표지(mark 의 vendorSessionId·fork, uuid 는 기록의 마지막 지점)를 남긴다. 세션 프로세스가 떠 있지 않을 때만 부른다(seq 는 core 가 쥔다). 빈 로그(처음 import)면 전부. 아니면 unrewound 로그의 turn.end·session.imported uuid 를 뒤에서부터 벤더 기록에서 찾아 그 뒤만 — 찾은 지점보다 뒤의 우리 턴이 벤더 기록에 없으면(벤더 쪽에서 되돌렸다) 그 첫 turn.start 부터 turn.rewound(conversation) 로 지운다. 하나도 못 찾으면: Claude 기록이 compact 요약으로 시작하면(그 뒤 벤더에서 compact 했다) 전부, 아니면 null(어디까지 가져왔는지 모른다 — 옛 Codex 세션). 붙일 것이 없으면 표지도 없다(처음 import 는 늘 남긴다)
}
type TimedEvent
type Pulled
