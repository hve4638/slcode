import { ClaudeSession } from './session'
import { CodexSession } from './codex'
import { AgentSession } from './base'
import { EventLog } from './eventLog'
import { isLoopback, reachable, sockAlive } from './live'
import { connectPost, VERSION, RpcClient } from './client'
import { corePaths, ensureDir, readOrCreateToken } from './paths'
import { CoreError, ERR, PROTOCOL_VERSION } from './protocol'
import { formatMail, parseMailHeads } from './mail'
import { startInspect, inspectEnv, upstreamOf, turnCalls, readCall, InspectProxy } from './inspect'

role: core — 세션 하나를 쥔 프로세스 (ticket slcode-core-serve-split, 설계 ws docs/report/slcode-core-serve-split.md, 사용자 확정 2026-10-15). serve 가 detached 로 띄운다(coreMain). 세션(AgentSession — meta.vendor 가 codex 면 CodexSession, 아니면 ClaudeSession; 새 세션의 벤더는 CoreOptions.vendor)·이벤트 로그·세션 소켓·우체국·입력 초안·웹 토큰 검사를 여기서 맡는다. Methods 는 sessions/<슬러그>/<id>/sock UDS 하나로만 낸다(소켓 0600 이 곧 인증) — 웹·stdio·서비스 웹은 serve 가 연결마다 이 소켓에 하나씩 붙어 중계한다. params.id 가 이 세션이 아니면 거절. 세션 선택: 새로 / resume id(find). 어느 세션을 이을지(continue 의 최근 세션 등)는 CLI·serve 가 이미 골랐다. 같은 세션의 소켓이 살아 있으면(붙어 본다) 거절 — 다른 slcode 가 서빙 중. 소유권: core.own 을 보낸 연결 하나가 소유자 — 살아 있는 다른 소유자가 있으면 owned 오류, takeover 면 빼앗고 옛 소유자 연결에 core.owner {pid} 를 보낸다. 소유자가 session.close 없이 끊기면(SIGKILL·크래시) OWNER_GRACE_MS(SLCODE_OWNER_GRACE_SECS, 기본 10초 — 빈 값·0·숫자 아님도 기본값: NaN 이면 setTimeout 이 1ms 로 다뤄 소유자가 붙기 전에 닫혔다) 동안 새 소유자를 기다리고 없으면 닫는다 — 기동 직후에도 같은 유예가 걸린다. session.close 는 누가 보내도 닫는다(CLI close). 소유자가 아닌 연결은 수명에 관여하지 않는다. 웹 주소: serve.register {host, port, version} 을 연결마다 기억하고(끊기면 지운다) url 을 만들어 돌려준다 — 루프백 밖 호스트면 토큰(slcode.token, core 가 든다)을 붙이고 reachable 로. server.info 의 host·port·url 은 처음 등록된 웹의 것(없으면 null), owner 는 소유자가 알린 pid, serves 는 등록된 웹들. core.auth: remote 가 붙어 오면(serve 가 루프백 밖 웹을 중계할 때) 토큰을 검사한다 — UDS 로 직접 붙는 CLI 는 토큰을 보지 않는다. 방송(session.changed·session.closed)은 모든 연결에. inspect(ticket slcode-inspect-proxy, 사용자 결정 2026-10-17): meta.inspect 가 켜진 Claude 세션이면 벤더를 띄우기 전에 세션 폴더 inspect/ 에 proxy 를 띄우고 벤더 env 를 inspectEnv 로 돌린다. session.setInspect {on} 은 Claude 세션이 idle(또는 starting)일 때만, 진행 중인 토글이 있으면 거절 — meta 에 남기고 ClaudeSession.reopen 으로 벤더를 다시 띄운다(켤 때는 proxy 를 먼저, 끌 때는 재기동 뒤에 proxy 를 닫는다; 실패하면 meta·새 proxy 를 되돌린다), session.changed 를 방송. session.inspectTurn {end} 은 turnCalls, session.inspectCall {n} 은 readCall(없으면 no_session 이 아니라 bad_request). 꺼진 뒤에도 남은 기록은 읽는다. 우체국: connectPost 로 붙어 post.register(pid 는 core 의 것 — list·close --force 가 이 pid 를 본다), 연결 유지; 시그널 mail → mail.fetch → seen 으로 중복 제거 → idle(첫 프롬프트 전 starting 포함)이면 즉시, 아니면 다음 idle 에 한 턴(origin 'mail', 여러 통은 한 본문)으로 session.send 하고 mail.ack. 우체국이 끊기면 재접속 — 세션 동작은 우체국과 무관. UDS 연결은 utf8 로 디코드한다 — 웹·stdio 프레임이 모두 이 스트림을 거치므로 청크 경계의 한글이 깨지면 안 된다. 수명: close(session.close·벤더 종료·소유자 유예 만료) → meta.closedAt 기록(먼저 — 벤더 종료 중 SIGKILL 을 맞아도 남게)·대기 ask 거절·세션 close(CLOSE_DEADLINE_MS 5초 상한 — core 는 detached 라 superlite 서비스 중지의 SIGKILL 이 닿지 않는다. 넘으면 로그를 남기고 정리를 이어 간다, 벤더 자식은 파이프가 닫혀 따라 끝난다)·UDS 닫고 남은 연결을 끝내(serve 의 중계·제어 연결이 닫힘을 본다) 소켓 삭제·우체국 연결 끊기(등록 해제). 닫는 중에 다시 부르면 같은 종료를 기다린다. 로그는 남아 resume. 옛 평탄 구조는 기동 때 EventLog.migrate. SDK 자식에는 STRIP_ENV 규칙으로 걸러 낸 env + SLCODE_SESSION=<id>(세션 안의 `slcode mail/check/ask/reply` 가 읽는다, 사용자 확정 2026-10-02). 메시징: 우편 턴 본문은 mail.ts formatMail(보낸 이 제목은 같은 디렉토리의 그 세션 meta 에서); 받은 우편 id→보낸 이 는 메모리에 두고 재기동 때 로그의 mail 턴에서 복원(session.reply 의 대상); session.ask 는 받는 이가 우체국 live 목록에 없으면 not_live 로 거절하고, 있으면 kind=ask 로 보내고 대기 표에 넣는다 — fetchMail 이 kind=reply 로 대기 중인 re 를 보면 턴에 넣지 않고 그 요청을 푼다(ack 포함), 타임아웃·닫힘이면 거절; session.check 는 지금 우체국에서 가져와 inbox 전부를 ack 하고 본문으로 돌려준다. 입력 초안(ticket slcode-card-periodic-reload, 사용자 결정 2026-10-10): session.setDraft 의 글을 메모리에 하나만 두고 session.attach 응답의 draft 로 돌려준다 — 디스크에 쓰지 않고 방송하지 않는다. 기록 페이지(ticket slcode-history-paging, 2026-10-17): session.attach 에 limit 이 오면 history 는 EventLog.historyPage 의 끝 페이지와 more·summary(summarize), session.history 는 before 앞 페이지 — 매번 메모리의 전체 로그에서 계산한다(되돌리기가 앞 페이지를 바꿀 수 있다).

export val STRIP_ENV
val SDK_ENV
val OWNER_GRACE_MS
val CLOSE_DEADLINE_MS
export fn stripEnv(env, rules) -> Env {
  role: 벤더 자식(claude·codex)에 넘길 env — 이 프로세스를 띄운 Claude 세션의 표식(CLAUDECODE·CLAUDE_CODE_SESSION_ID 등)은 빼고 사용자 설정(CLAUDE_CONFIG_DIR 등)은 남긴다 (ticket slcode-claude-config-dir-and-new-test, 사용자 2026-10-15). 규칙은 STRIP_ENV — gitignore 꼴 패턴 목록: 줄마다 변수 이름 패턴(`*` 는 아무 글자), `!` 로 시작하면 빼지 않는다, 위에서부터 보고 마지막으로 맞은 줄이 정한다. 어느 변수가 표식인지는 규칙이 없고 Claude Code 버전마다 바뀔 수 있어 코드가 아닌 이 목록을 고친다
}
export fn runCore(opts) -> CoreHandle {
  role: 세션 선택·생성 → 벤더 세션 → UDS listen → 우체국 등록 → 소유자 유예 시작 → {sock, session, close, done}. 벤더가 기동 중에 죽으면 닫고 그 사유로 던진다
}
type CoreOptions
type CoreHandle
