import { ClaudeSession } from './session'
import { CodexSession } from './codex'
import { AgentSession } from './base'
import { EventLog } from './eventLog'
import { isLoopback, reachable, sockAlive, spawnCore } from './live'
import { BUILD, VERSION, replacingMark } from './client'
import { corePaths, ensureDir, readOrCreateToken } from './paths'
import { CoreError, ERR, PROTOCOL_VERSION } from './protocol'
import { formatMail, parseMails, newMail, sendMail, sessionMeta } from './mail'
import { startInspect, inspectEnv, upstreamOf, turnCalls, keepsFirstParty, sdkVersion, inspectBlocked, blockInspect, InspectProxy, CODEX_ROUTE, codexArgs, codexUpstream } from './inspect'
import { InspectStore, maybeSweep } from './inspectDb'

role: core — 세션 하나를 쥔 프로세스 (ticket slcode-core-serve-split, 설계 ws docs/report/slcode-core-serve-split.md, 사용자 확정 2026-10-15). serve 가 detached 로 띄운다(coreMain). 세션(AgentSession — meta.vendor 가 codex 면 CodexSession, 아니면 ClaudeSession; 새 세션의 벤더는 CoreOptions.vendor, 모델은 CoreOptions.model 이 있으면 meta.model, effort 는 CoreOptions.effort 가 있으면 meta.effort — 벤더가 기동 때 그 값을 읽는다(Claude options.model·effort, Codex thread/start·turn/start model, turn/start effort), 이어받는 세션은 meta 를 따른다. 새 세션의 CoreOptions.prompt 는 세션을 만들자마자 session.send(origin 없음)로 넣는다 — 벤더 준비 전이라도 첫 턴으로 돈다, ticket slcode-new-effort-prompt)·이벤트 로그·세션 소켓·받은 메시지·입력 초안·웹 토큰 검사를 여기서 맡는다. Methods 는 sessions/<슬러그>/<id>/sock UDS 하나로만 낸다(소켓 0600 이 곧 인증) — 웹·stdio·서비스 웹은 serve 가 연결마다 이 소켓에 하나씩 붙어 중계한다. params.id 가 이 세션이 아니면 거절. 세션 선택: 새로 / resume id(find). 어느 세션을 이을지(continue 의 최근 세션 등)는 CLI·serve 가 이미 골랐다. 같은 세션의 소켓이 살아 있으면(붙어 본다) 거절 — 다른 slcode 가 서빙 중. 소유권: core.own 을 보낸 연결 하나가 소유자(follows 면 그 소유자가 core.replaced 를 따라 다시 붙는다 — 3단계 core 교체의 조건) — 살아 있는 다른 소유자가 있으면 owned 오류, takeover 면 빼앗고 옛 소유자 연결에 core.owner {pid} 를 보낸다. 소유자가 session.close 없이 끊기면(SIGKILL·크래시) OWNER_GRACE_MS(SLCODE_OWNER_GRACE_SECS, 기본 10초 — 빈 값·0·숫자 아님도 기본값: NaN 이면 setTimeout 이 1ms 로 다뤄 소유자가 붙기 전에 닫혔다) 동안 새 소유자를 기다리고 없으면 닫는다 — 기동 직후에도 같은 유예가 걸린다. session.close 는 누가 보내도 닫는다(CLI close). 소유자가 아닌 연결은 수명에 관여하지 않는다. 웹 주소: serve.register {host, port, version} 을 연결마다 기억하고(끊기면 지운다) url 을 만들어 돌려준다 — 루프백 밖 호스트면 토큰(slcode.token, core 가 든다)을 붙이고 reachable 로. server.info 의 host·port·url 은 처음 등록된 웹의 것(없으면 null), owner 는 소유자가 알린 pid, serves 는 등록된 웹들, version·build 는 이 core 의 것(client.BUILD — 3단계 core 교체가 serve 의 것과 견준다). core.auth: remote 가 붙어 오면(serve 가 루프백 밖 웹을 중계할 때) 토큰을 검사한다 — UDS 로 직접 붙는 CLI 는 토큰을 보지 않는다. 방송(session.changed·session.closed)은 모든 연결에. inspect(ticket slcode-inspect-proxy, 사용자 결정 2026-10-17·slcode-inspect-default-on 2026-10-19): 새 세션은 opts.inspect(CLI 가 입구 설정을 읽어 넘긴다)가 참일 때만 meta.inspect 를 남기고, 이어받는 세션은 meta 를 따르되 opts.inspect 가 false(--no-inspect)면 켜져 있던 것만 끈다. meta.inspect 가 켜진 Claude 세션이면 벤더를 띄우기 전에 세션 폴더 inspect/inspect.db(InspectStore)와 proxy 를 세우고 벤더 env 를 inspectEnv 로 돌린다 — 원래 1st party 면(keepsFirstParty) proxy 가 감시한다. Codex 세션(ticket slcode-inspect-codex, 사용자 결정 2026-10-19)은 같은 proxy 를 prefix CODEX_ROUTE 로 세워 app-server 인자 codexArgs 로 주고, 업스트림은 요청마다 codexUpstream — 사용자가 정한 openai_base_url 은 CodexSession 의 onConfig(config/read)로 알게 되며 그 전에 온 요청은 기다린다. Codex 감시: proxy 를 세운 뒤 처음 성공한 turn.end 까지 proxy 가 받은 경로(seen)에 /responses 가 없으면 사유를 남기고 Claude 의 감시와 같은 길(다음 idle 에 setInspect(false))로 끈다 — 이 세션만, 막힌 기록은 남기지 않는다. 상태 폴더의 inspect-blocked.json 이 이 SDK 버전을 막았거나(Claude 만) node:sqlite 가 없으면 첫 기동은 meta.inspect 를 끄고 띄운 뒤 기록에 사유(error 이벤트, AgentSession.notice)를 남기고, setInspect 켜기는 그 사유로 거절한다. 감시가 플래그가 듣지 않는다고 알리면(onLost) blockInspect 로 SDK 버전을 기록하고 사유를 남긴 뒤, 세션이 idle 이고 줄 선 턴이 없는 첫때(queued) setInspect(false) 와 같은 길로 proxy 없이 다시 띄운다 — 실패하면 다음 idle 에 다시, 구독은 꺼진 뒤에 푼다(그사이 사이드바로 껐으면 그만). inspect 를 끄면 정리 타이머도 멈춘다. proxy 를 처음 띄울 때와 그 뒤 1시간마다 maybeSweep(3일마다, 잠금을 잡은 core 하나가 상태 폴더의 꺼진 세션 raw 정리) — 기록이 늘어나는 것은 proxy 가 떠 있을 때뿐이라 정리도 그때. session.setInspect {on} 은 세션(Claude·Codex)이 idle(또는 starting)일 때만, 진행 중인 토글이 있으면 거절 — meta 에 남기고 ClaudeSession.reopen 으로 벤더를 다시 띄운다(Claude 는 env, Codex 는 app-server 인자; 켤 때는 proxy 를 먼저, 끌 때는 재기동 뒤에 proxy 를 닫는다; 실패하면 meta·새 proxy 를 되돌린다), session.changed 를 방송. session.inspectTurn {end} 은 turnCalls, session.inspectCall {n} 은 InspectStore.read(없거나 지웠으면 no_session 이 아니라 bad_request). 꺼진 뒤에도 남은 기록은 읽는다 — DB 가 없는 세션(켠 적 없음)엔 만들지 않는다. 닫을 때 proxy·정리 타이머·DB 를 닫는다. 받은 메시지(ticket slcode-p2p-messaging, 사용자 결정 2026-10-19): session.deliver 를 seen(id)으로 중복 제거해 메모리에 두고 → idle(첫 프롬프트 전 starting 포함)이면 즉시, 아니면 다음 idle 에 한 턴(origin 'mail', 여러 통은 mail.ts 머리표를 빈 줄로 이은 한 본문)으로 session.send. 보관함은 없다 — 닫히면 아직 넘기지 않은 것은 사라진다(꺼진 세션에는 보내지 않는다는 결정의 연장). pid 는 listen 뒤 meta.pid 에 남긴다 — close --force·list 가 본다. UDS 연결은 utf8 로 디코드한다 — 웹·stdio 프레임이 모두 이 스트림을 거치므로 청크 경계의 한글이 깨지면 안 된다. 수명: close(session.close·벤더 종료·소유자 유예 만료) → meta.closedAt 기록(먼저 — 벤더 종료 중 SIGKILL 을 맞아도 남게)·대기 ask 거절·세션 close(CLOSE_DEADLINE_MS 5초 상한 — core 는 detached 라 superlite 서비스 중지의 SIGKILL 이 닿지 않는다. 넘으면 로그를 남기고 정리를 이어 간다, 벤더 자식은 파이프가 닫혀 따라 끝난다)·UDS 닫고 남은 연결을 끝내(serve 의 중계·제어 연결이 닫힘을 본다) 소켓 삭제. 닫는 중에 다시 부르면 같은 종료를 기다린다. 로그는 남아 resume. 옛 평탄 구조는 기동 때 EventLog.migrate. SDK 자식에는 STRIP_ENV 규칙으로 걸러 낸 env + SLCODE_SESSION_ID=<id>(세션 안의 `slcode mail/check/ask/reply` 가 읽는다, 사용자 확정 2026-10-02). 메시징: 턴 본문은 mail.ts formatMail(name 은 from 세션의 제목, sessionMeta 로 meta 만 읽는다); 받은 메시지 id→보낸 이 는 메모리에 두고 재기동 때 로그의 mail 턴에서 parseMails 로 복원(session.reply 의 대상); session.ask 는 sendMail 로 kind=ask 를 켜진 세션에 보내고(아니면 no_session) 대기 표에 넣는다 — 받은 kind=reply 가 대기 중인 re 를 가리키면 턴에 넣지 않고 그 요청을 푼다, 타임아웃·닫힘이면 거절; session.check 는 밀린 것 전부를 본문으로 돌려준다(턴으로 다시 오지 않는다). 입력 초안(ticket slcode-card-periodic-reload, 사용자 결정 2026-10-10): session.setDraft 의 글을 메모리에 하나만 두고 session.attach 응답의 draft 로 돌려준다 — 방송하지 않고, 디스크에는 core 교체 때만 쓴다(아래). 기록 페이지(ticket slcode-history-paging, 2026-10-17): session.attach 에 limit 이 오면 history 는 EventLog.historyPage 의 끝 페이지와 more·summary(summarize), session.history 는 before 앞 페이지 — 매번 메모리의 전체 로그에서 계산한다(되돌리기가 앞 페이지를 바꿀 수 있다). core 교체(ticket slcode-core-serve-split 3단계, 사용자 2026-10-19 — 설계 "core 교체"): core.retire {pkg} 는 새 코드의 serve 가 보낸다(pkg 는 그 serve 의 설치 폴더 — 원격 deploy 는 버전마다 폴더가 다르다). 받으면 먼저 pkg 의 dist/cli.js --version --json 이 도는지 확인하고(새 빌드가 깨졌으면 bad_request — 교체하지 않고 이 core 가 계속 일한다, 사용자 결정), 소유자가 있으면 follows 여야 한다(아니면 bad_request — 2단계 진입 프로세스는 core 연결이 끊기면 세션을 끝낸다). {ok} 로 답하고 교체할 수 있는 때를 기다린다: state idle·대기 승인 없음·줄 선 턴 없음(ClaudeSession.queued)·밀린 메시지와 대기 ask 없음·background task 없음(task 이벤트의 background 로 들고 ended 로 뺀다)·inspect 토글 중 아님. 보낸 연결이 그 전에 끊기면 취소, 이미 기다리는 중이면 새 요청으로 바꾼다. 때가 되면 retiring: 그 뒤 오는 요청은 ERR.retiring 으로 거절한다(session.deliver 도 — 보낸 쪽이 새 core 에 다시 보낸다; 받은 척하고 버리지 않는다). 소켓 옆 표시(client.replacingMark)에 기한 REPLACE_MS 를 쓰고 UDS 를 닫아 소켓을 지운다 — 그동안 붙으려는 쪽은 표시를 보고 기다린다. 초안을 세션 폴더의 draft 파일에 쓰고, 벤더를 조용히 내린다(close quiet — session.exit·exited 를 남기지 않는다, CLOSE_DEADLINE_MS 상한), inspect proxy·정리 타이머·DB 를 닫고, pkg 의 dist/coreMain.js 를 resume <id> 로 spawnCore 한다. 새 core 가 준비되면 core.replaced {pid, version} 을 모든 연결에 보내고 연결을 끝낸 뒤 표시를 지우고 done — closedAt 은 남기지 않는다. 새 core 가 뜨지 못하면 표시를 지우고 그 사유로 세션을 닫는다(closedAt·session.closed — 띄운 뒤의 실패는 되돌릴 core 가 없다). 새로 뜬 core 는 draft 파일이 있으면 초안으로 읽고 지운다. inspect 는 새 core 가 meta 를 보고 proxy(새 포트)를 다시 세우고 같은 inspect.db 를 연다. 이어지지 않는 것은 resume 과 같다 — 벤더 자식이 다시 떠 MCP 상태·세션 한정 승인 규칙·셸 상태는 초기화된다. 소켓은 벤더 기동을 기다리지 않고 연다(벤더는 생성자에서 뒤로 뜬다) — 그 사이 받은 메시지는 starting 처럼 쌓였다가 첫 idle 에 들어간다.

export val STRIP_ENV
val SDK_ENV
val OWNER_GRACE_MS
val CLOSE_DEADLINE_MS
val REPLACE_MS
export fn stripEnv(env, rules) -> Env {
  role: 벤더 자식(claude·codex)에 넘길 env — 이 프로세스를 띄운 Claude 세션의 표식(CLAUDECODE·CLAUDE_CODE_SESSION_ID 등)은 빼고 사용자 설정(CLAUDE_CONFIG_DIR 등)은 남긴다 (ticket slcode-claude-config-dir-and-new-test, 사용자 2026-10-15). 규칙은 STRIP_ENV — gitignore 꼴 패턴 목록: 줄마다 변수 이름 패턴(`*` 는 아무 글자), `!` 로 시작하면 빼지 않는다, 위에서부터 보고 마지막으로 맞은 줄이 정한다. 어느 변수가 표식인지는 규칙이 없고 Claude Code 버전마다 바뀔 수 있어 코드가 아닌 이 목록을 고친다
}
export fn runCore(opts) -> CoreHandle {
  role: 세션 선택·생성 → 벤더 세션 → UDS listen → meta.pid → 소유자 유예 시작 → {sock, session, close, done}. 벤더가 기동 중에 죽으면 닫고 그 사유로 던진다
}
type CoreOptions
type CoreHandle
