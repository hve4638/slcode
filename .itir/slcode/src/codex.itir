import { ApprovalRequest, Attachment, LimitWindow } from './protocol'
import { AgentSession } from './base'
import { EventLog } from './eventLog'

role: Codex 어댑터 (ticket agent-core-codex, codex-cli 0.159 실측 2026-09-30) — 세션 하나 = `codex app-server` 자식 프로세스 하나, stdio 위 JSON-RPC 줄 단위(개행 구분, Content-Length 없음). initialize(clientInfo, capabilities.experimentalApi) → initialized → thread/start(cwd, approvalPolicy, sandbox) 또는 thread/resume(threadId=meta.vendorSessionId, excludeTurns) → turn/start(threadId, input[text|image url], model·effort·approvalPolicy·sandboxPolicy 는 턴마다). 알림을 벤더 중립 이벤트로: item/agentMessage/delta→text.delta, item/reasoning/(summary)textDelta→thinking.delta, item/started·completed 의 commandExecution→tool Bash, fileChange→tool Edit, mcpToolCall→tool mcp:<server>/<tool>, dynamicToolCall·webSearch→tool, collabAgentToolCall→task, contextCompaction·thread/compacted→context.compacted, turn/completed→turn.end(status completed/interrupted/failed, usage 는 마지막 thread/tokenUsage/updated 의 last, costUsd 는 Codex 가 주지 않아 내장 가격표로 추정한 프로세스 누계 — total 이 늘어난 만큼을 그때 모델 값으로 더하고, 이번 턴에 값을 매긴 사용량이 없으면 null), error→error. 서버→클라이언트 요청이 승인이다: item/commandExecution/requestApproval·item/fileChange/requestApproval→approval.requested(allow→accept, remember→acceptForSession, deny→decline, 취소→cancel), item/tool/requestUserInput→AskUserQuestion 꼴 approval.requested(답은 answers{questionId:{answers[]}}), item/permissions/requestApproval→allow 면 요청한 프로필 그대로 scope session, mcpServer/elicitation/request→cancel. 권한 모드 대응(t3code runtimeMode 매핑 안, approvalsReviewer 는 auto 만 auto_review 고 나머지는 user): default→untrusted+readOnly(명령·편집 모두 묻는다), acceptEdits→on-request+workspaceWrite, plan→on-request+readOnly, bypassPermissions→never+dangerFullAccess, auto→on-request+workspaceWrite+auto_review(승인 요청을 사용자 대신 Codex 의 검토 서브에이전트가 위험도로 허용·거부 — Claude 의 auto 분류기에 대응, 규칙 범위는 acceptEdits 와 같게 고정, 사용자 결정 2026-10-09). item/autoApprovalReview/completed→review 이벤트(started 와 guardianWarning 은 같은 내용의 앞뒤라 버린다, codex-cli 0.159 실측 2026-10-09). thread/resume 이 not found 면 thread/start 로 대체. meta.forkFrom(slcode import --fork, 2026-10-07)이 있고 vendorSessionId 가 아직 없으면 첫 기동은 thread/fork(threadId=forkFrom, excludeTurns) 로 새 thread 를 받는다 — 원본이 없으면 대체 없이 실패. 다른 threadId(서브에이전트 자식 thread)의 알림은 버린다. 리밋은 account/rateLimits/updated 의 primary(300분)·secondary(10080분) 를 5h·1w 창으로, 컨텍스트는 tokenUsage.last(마지막 턴의 컨텍스트; total 은 누계) 대 modelContextWindow. 슬래시 명령은 compact 하나(/compact → thread/compact/start, 압축은 Codex 안에서 한 턴으로 돌아 turn/started·contextCompaction 항목·turn/completed 가 온다; 나머지 / 는 Codex TUI 전용이라 없다). rewind 는 미지원(thread/revert 는 후속). 기동 경합은 프로세스마다 app-server 를 따로 띄우므로 없다 — CODEX_HOME 의 app-server-control.sock·startup.lock 은 codex 자체 데몬 것이라 건드리지 않는다

type CodexOptions
export fn estimateCostUsd(model, u) -> Float? {
  role: 공식 가격표(USD / 1M 토큰: 입력·캐시 입력·출력, 캐시 쓰기는 입력의 1.25배)로 토큰 수의 비용 추정. inputTokens 는 캐시 읽기·쓰기 포함. 272K 할증은 셈하지 않는다. 표에 없는 모델은 null (사용자 2026-10-09)
}
export class CodexSession {
  role: AgentSession 구현 — 자식 프로세스 수명 = 세션 수명. turn 이 진행 중이면 send 는 큐에 넣어 turn/completed 뒤 다음 turn/start 로 (Claude 의 streaming input 과 같은 겉모습)
  export fn send(text, origin, attachments) {
    role: turn.start 이벤트 뒤 turn/start — 이미지는 data URL 로 image 입력, 그 밖 첨부는 본문 인라인
  }
  export fn models() {
    role: model/list → {value: id, resolvedModel: model, displayName, description, efforts: supportedReasoningEfforts}
  }
  export fn setModel(model) {
    role: 다음 turn/start 의 model. meta 에 남는다
  }
  export fn setEffort(effort) {
    role: 다음 turn/start 의 effort. meta 에 남는다
  }
  export fn setMode(mode) {
    role: 다음 turn/start 의 approvalPolicy·sandboxPolicy. meta.permissionMode 에 남는다
  }
  export fn commands() {
    role: 빈 배열
  }
  export fn limits() {
    role: 마지막 account/rateLimits/updated, 없으면 account/rateLimits/read
  }
  export fn context() {
    role: 마지막 thread/tokenUsage/updated 의 last.totalTokens / modelContextWindow (total 은 누계라 안 쓴다)
  }
  export fn interrupt() {
    role: turn/interrupt(threadId, turnId) + 대기 승인 cancelled
  }
  export fn approve(requestId, decision, opts) -> Bool {
    role: 대기 중인 서버 요청에 응답을 써 준다
  }
  export fn rewind(seq, conversation, files) {
    role: 미지원 — 오류
  }
  export fn close(reason) {
    role: 진행 턴 interrupt → 프로세스 종료 → session.exit·exited
  }
}
