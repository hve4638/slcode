import { BUILD, connectSession, connectSock, diskBuild, PKG, VERSION } from './client'
import { corePaths, readOrCreateToken } from './paths'
import { closedSessions, isLoopback, spawnCore } from './live'
import { readSettings, watchSettings, writeSettings } from './settings'
import { CoreError, ERR, FILES, SettingsKind, SettingsPatch, UpdateCheck } from './protocol'
import { inspectBlocked } from './inspect'
import { inspectUsage, cleanInspect } from './inspectDb'

role: serve — 화면이 세션에 닿는 통로 (ticket slcode-core-serve-split, 설계 ws docs/report/slcode-core-serve-split.md, 사용자 확정 2026-10-15). 세션은 core 가 쥔다. serve 는 core 를 detached 로 띄우는 데 필요한 최소 정보(폴더·이어받을 id·세션 옵션 — continueLast 면 closedSessions 의 첫째, 없으면 새로)만 넘기고, 그 뒤로는 세션 소켓으로만 이야기한다. 제어 연결 하나: 소유자면 core.own {pid} 를 보내고, TCP 웹을 열면 serve.register 로 주소를 알려 core 가 만든 url(토큰 포함)을 받는다. core.owner 를 받으면(소유권을 빼앗김 — 카드 핸드오프) 그 뒤로는 닫혀도 세션을 닫지 않는다. 중계: 화면 연결(TCP 웹 WS·서비스 웹 WS·stdio) 하나마다 세션 소켓 연결 하나를 잇고 프레임은 해석하지 않고 그대로 넘긴다. 제어 메서드(CONTROL_ONLY — core.own·serve.register)는 화면 연결에서 늘 bad_request 로 거절한다(웹 클라이언트가 소유권을 빼앗거나 토큰이 붙은 url 을 받아 가지 못하게; 메서드 이름이 프레임에 들어 있을 때만 해석). 루프백 밖 호스트의 TCP 웹은 core.auth 에 remote 를 붙여 넘기고(토큰 검사는 core; id 가 number·string 이 아니면 거절), 통과할 때까지 다른 요청은 unauthorized 로 막고 그 사이 온 요청은 HELD_MAX(64)까지 줄 세웠다가 통과하면 보낸다; core 의 프레임도 auth 응답 말고는 넘기지 않는다. 서비스 웹(webSock, superlite relay /svc — ticket plugin-service-web)과 stdio 는 인증 없음(UDS 와 같은 신뢰 경계). stdio 는 첫 줄이 올 때 세션 소켓에 붙는다 — CLI 가 먼저 hello 를 내고 그 앞에 core 의 방송이 끼지 않게; stdin 이 닫히면 그 연결만 끊고, 소유자면 세션은 산다. attach(이미 떠 있는 세션 — resume --stdio 가 살아 있는 세션을 만난 길): core 를 띄우지 않고 소유자도 아니다, stdin 이 닫히면 끝난다, 서비스 웹을 열지 못해도 로그만 남기고 stdio 중계는 계속한다, 옛 빌드 세션의 server.info 응답에 url 이 없으면 hello 의 url 로 채운다. 화면 설정(ticket slcode-web-settings, 2026-10-16): settings.get·set 은 core 로 넘기지 않고 serve 가 답한다 — 설정은 세션이 아니라 입구의 것이고, 웹 파일을 내주는 serve 가 답하므로 옛 core 에 붙어도 된다. 묶음(SettingsKind)은 연결이 들어온 입구가 정한다: TCP 웹은 web, 서비스 웹·stdio 는 superlite (두 벌은 완전히 따로, 사용자 결정 2026-10-16). 메서드 이름이 프레임에 들어 있을 때만 해석하고, 루프백 밖 웹은 인증 뒤에만(인증 전에 줄 세운 요청도 같은 길로). 상태 폴더를 입구마다 감시해(watchSettings) 그 설정 파일이 바뀌면 그 입구의 인증된 화면 연결 모두에 settings.changed — 쓴 serve 도 자기 감시로 알린다(길이 하나). 세션 파일은 (inspect 캐시 정리 말고는) 건드리지 않는다 — 직접 다루는 파일은 자기 설치 폴더의 web/ 정적 파일(시작 때 한 번 읽어 고정)과 상태 폴더의 settings-*.json(읽기·쓰기·감시), 그리고 화면이 요청한 로컬 파일(fileHandler, 읽기만)뿐. 수명: 소유자 serve 의 close(Ctrl-C·SIGTERM·SIGHUP)는 session.close 를 보내고 core 가 끝나기를(제어 연결이 닫힐 때까지, 최대 15초) 기다린다 — core 는 detached 라 serve 가 먼저 kill 돼도 스스로 닫기를 마친다; 닫는 중에 다시 부르면 같은 종료를 기다린다. core 가 끝나면(세션 닫힘·벤더 종료·크래시) serve 도 웹·중계를 닫고 done. serve 교체(ticket slcode-core-serve-split 2단계, 사용자 2026-10-19): serve 가 답하는 메서드(SERVE_METHODS)에 serve.info({VERSION, BUILD, pid, update, inspectBlocked — 상태 폴더의 inspect-blocked.json 이 이 SDK 를 막았으면 그 버전})·update.run(웹 입구만 — diskBuild 가 VERSION·BUILD 와 다르면 restart-required 를 update 에 기억해 serve.info 로도 돌려준다; 카드 입구는 bad_request — 플러그인이 확인한다)·serve.restart(onRestart 가 있을 때만 — 진입 프로세스가 새 serve 를 준비시킨 뒤 답한다; 없으면 bad_request)를 더했다. 카드 모드(ticket slcode-card-svc-token-dead, 사용자 2026-10-20): SERVE_METHODS 에 web.files(webFiles)·file.get(fileGet) — 카드 화면이 /svc 토큰 주소 없이 플러그인의 stdio 중계로만 serve 에 닿는다. 어느 입구에서든 답한다(웹 입구도 해는 없다). inspect 캐시 정리(ticket slcode-inspect-storage, 사용자 확정 2026-10-20): inspect.usage(미리보기 — inspectUsage)·inspect.clean(what 이 old·compact·all — cleanInspect)도 serve 가 답한다. 상태 폴더 전체의 일이라 입구와 상관없고, 세션 파일 중 꺼진 세션의 inspect/ 만 다룬다(떠 있는 세션은 뺀다). attach.takeover 면 떠 있는 core 에 core.own {takeover} 로 소유권을 빼앗아 소유자가 된다(카드 핸드오프의 새 카드 — resume --stdio --takeover); 소유자라도 남의 세션이라 웹을 열지 못해도 세션을 닫지 않는다(세션을 닫는 실패는 core 를 이 serve 가 띄웠을 때만). feed 면 listen 하지 않고 진입 프로세스(entry)가 넘긴 TCP 연결을 http 서버에 넣어 서빙하고(웹 입구, 루프백 밖이면 core.auth 게이트) serve.register 에는 진입 프로세스가 listen 한 host·port 를 알린다; 닫힐 때 화면 WS 를 1012 로 닫고 받은 연결을 끊어 화면이 다음 serve 로 다시 붙게 한다. core 교체(ticket slcode-core-serve-split 3단계, 사용자 2026-10-19): 소유자는 core.own 에 follows 를 붙인다. 제어 연결이 core.replaced 를 받은 뒤 끊기면 serve 를 끝내지 않고 같은 소켓에 다시 붙어(connectSession 이 교체 표시를 보고 기다린다) core.own·serve.register 를 다시 보낸다 — 다시 붙지 못하면 core 가 끝난 것과 같다. 제어 연결이 (다시) 붙을 때마다 server.info 의 build 가 이 serve 의 BUILD 보다 옛 것이면 core.retire {pkg: PKG} 를 보낸다 — 소유자이거나 feed(웹 모드 serve 자식)일 때만, 옛 core 가 모르는 메서드면 그만. 새 serve 는 사용자가 [restart required] 를 눌러야 생기므로 core 교체도 그 뒤에 드러나지 않게 따라온다. 중계 연결도 화면에 드러나지 않게 다시 붙는다: core 의 core.replaced 를 받으면(화면에 넘기지 않는다) 화면의 요청을 줄 세우고, 끊기면 connectSock 으로 다시 붙어 그 화면이 보냈던 core.auth 를 다시 보내고(응답은 삼킨다), 붙어 있던 세션이면 session.attach {since: 화면에 넘긴 마지막 seq} 를 보내 끊긴 동안의 기록을 session.event 로, 새 info 를 session.changed 로 화면에 넘긴다. 그 뒤 답을 받지 못한 요청과 retiring 으로 거절된 요청을 다시 보내고 줄 세운 것을 보낸다. 요청·응답 id 와 seq 는 프레임 앞머리만 보고 읽는다(첨부가 실린 큰 프레임을 해석하지 않게) — attach 응답만 한 번 해석해 마지막 seq 를 안다. 다시 붙지 못하면 그 화면 연결을 끝낸다.

export val WEB_DIR
val CONTROL_ONLY
val HELD_MAX
val SERVE_METHODS
export fn serveSession(opts) -> ServeHandle {
  role: web/ 을 메모리에 고정(loadWeb) → core 띄우기(또는 attach) → 제어 연결(core.own) → (webSock 이면) 서비스 웹 http+wss → (web 이면) TCP http+wss 와 serve.register → (stdio 면) stdin 중계 → {url, sock, session, close, done}. 웹을 열지 못하면 소유자는 세션을 닫고 던진다
}
export fn loadWeb(root) {
  role: web/ 아래 파일 전부를 읽어 상대 경로('/' 구분) → 내용 Map 으로 — serve 가 시작할 때 한 번 (ticket slcode-settings-set-unknown-method). 플러그인 Update 는 떠 있는 serve 를 둔 채 설치 폴더의 파일만 바꾸므로, 요청마다 디스크를 읽으면 옛 serve 가 새 웹을 내보내 옛 serve 가 모르는 요청(settings.set 등)이 core 까지 가 unknown method 가 된다. 고정하면 serve 는 자기 코드와 같은 버전의 웹만 보낸다 — 대신 web/ 을 고친 뒤에는 serve 를 다시 띄워야 화면에 보인다
}
export fn staticHandler(req, res, web, dir, kind) {
  role: web/ 정적 파일(loadWeb 이 고정한 Map 에서) — TCP 웹과 서비스 웹이 같이 쓴다. Map 에 없는 경로는 404 (디렉터리면 그 아래 index.html). 페이지의 주소는 상대라 relay /svc/<토큰>/ 접두사 아래에서도 돈다. dir 이 있으면 index.html 의 <html> 에 그 상태 폴더·입구(kind — TCP 웹은 web, 서비스 웹은 superlite)의 테마(data-theme, [\w-] 만)를 넣어 보낸다 — 연결 전 첫 화면부터 그 테마로(카드 iframe 이 다시 로드될 때 시스템 색이 비치지 않게). 이 serve 의 VERSION(data-version)도 함께 넣는다 — 웹은 이 serve 가 고정한 것이라 화면의 버전이고, 설정 창이 server.info 의 세션(core) 버전과 견줘 다르면 core 버전을 괄호로 붙인다 (ticket slcode-web-version-display). BUILD(data-build)와 입구(data-kind)도 — 화면이 다시 붙은 serve 가 이 페이지를 낸 serve 인지(serve.info), [업데이트] 를 serve 와 플러그인 중 누구에게 물을지 안다 (2단계)
}
export fn fileHandler(req, res, token) -> Bool {
  role: 로컬 파일 (ticket slcode-append-system-prompt, 사용자 결정 2026-10-17) — 답변의 마크다운 링크·이미지가 가리키는 절대 경로를 `file?path=<절대 경로>` 로 내보낸다. TCP 웹·서비스 웹이 같이 쓰고, 경로가 file 이 아니면 false(정적 파일로). 범위는 serve 사용자가 읽을 수 있는 모든 파일 — 토큰을 통과한 화면은 이미 에이전트로 무엇이든 읽힐 수 있어 경로 제한의 실익이 작다. token 이 있으면(루프백 밖 웹 — 세션과 같은 slcode.token) 쿼리의 token 이 같아야 한다. 경로가 없고 끝이 :줄(:열) 이면 떼고 다시 본다(Codex 의 파일 링크 꼴). 응답은 CSP sandbox·nosniff·no-referrer — 같은 출처로 열린 html·svg 가 스크립트를 돌려 화면의 토큰(localStorage)이나 /ws 에 닿지 못하게. 형식은 확장자로, 모르는 확장자는 앞 8KB 에 NUL 이 없으면 text/plain 아니면 내려받기
}
export fn webFiles(web, dir, kind) {
  role: 카드 모드 화면 파일 (ServeMethods web.files, ticket slcode-card-svc-token-dead, 사용자 2026-10-20) — superlite 플러그인이 stdio 로 받아 주소 없는 sandbox iframe(srcdoc)에 넣는다. html 은 web/card.html 에 staticHandler 의 index.html 과 같은 data-theme·version·build·kind 를 넣은 것, files 는 loadWeb 이 고정한 web/ 의 .js·.css 전부(상대 경로 → 글). 이 serve 가 고정한 웹이라 화면과 serve 의 버전이 같다
}
export fn fileGet(path) {
  role: 카드 모드의 로컬 파일 (ServeMethods file.get) — fileHandler 와 같은 범위(절대 경로만, 없으면 끝의 :줄(:열) 을 떼고 다시, 형식도 같은 규칙)를 {mediaType, size, data(base64)} 로. 32MB 를 넘으면 bad_request(stdio 한 줄에 싣는다 — 큰 파일은 데몬·superlite 화면이 통째로 해석한다). 없으면 bad_request 'not found'
}
export fn listenAddr(server, addr) {
  role: 서비스 웹 소켓 주소(SUPERLITE_SERVICE_WEB)에 listen — `/` 로 시작하면 uds(남은 파일 지우고 0600), 아니면 host:port
}
type ServeOptions
type ServeHandle
