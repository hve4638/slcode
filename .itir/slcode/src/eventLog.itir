import { LoggedEvent, SessionInfo } from './protocol'
import { cwdSlug, sessionDir } from './paths'

role: 세션별 이벤트 로그 영속 — sessions/<cwd 슬러그>/<id>/meta.json(SessionMeta, tmp+rename, updatedAt 은 turn.end 마다, closedAt 은 세션 프로세스가 닫힐 때 — continue·resume 목록의 꺼진 순서) + events.jsonl(한 줄 = LoggedEvent, append 열기 유지). 프로세스가 죽어도 남아 attach {since} 재생과 --resume 복원의 바탕. 옛 평탄 구조는 migrate 가 옮긴다 (옛 중앙 core 가 살아 있으면 보류). 메모리에도 전체를 든다 (attach 재생이 잦다) — 큰 세션 상한은 남긴 엣지. 깨진 마지막 줄(죽을 때 반쯤 쓴 것)은 건너뛴다. sockPath 는 세션 폴더의 sock 이되 유닉스 소켓 경로 상한(100바이트 기준)을 넘으면 `<SLCODE_DIR>/sock/<id>` 로 폴백한다 — id 만으로 정해져 서버·클라이언트가 같은 값을 계산한다 (2026-10-04 실측: 워크트리 경로 슬러그로 listen 실패)

export class EventLog {
  role: 로그 하나 = 세션 하나. seq 는 파일의 마지막 seq 에서 이어진다
  export fn create(sessionsDir, meta) -> EventLog {
    role: 새 세션 — 디렉토리 0700·meta 기록
  }
  export fn open(sessionsDir, id, cwd) -> EventLog? {
    role: 저장 로그 열기 — cwd 를 알면 그 슬러그, 모르면 find (meta 없으면 null)
  }
  export fn find(sessionsDir, id) -> Path? {
    role: id 만으로 세션 폴더 찾기 — 슬러그 폴더를 훑는다 (CLI 관리 명령)
  }
  export fn migrate(sessionsDir) -> Int {
    role: sessions/<id>/ → sessions/<슬러그>/<id>/ 이동, 옮긴 수. core.pid 의 옛 core 가 살아 있으면 0
  }
  export fn list(sessionsDir, cwd) -> SessionMeta[] {
    role: 저장 세션 meta — cwd 를 주면 그 슬러그 폴더만 (--continue), 없으면 전부. createdAt 순
  }
  export fn remove(sessionsDir, id) {
    role: CLI delete
  }
  export fn since(seq) -> LoggedEvent[] {
    role: seq 뒤 이벤트 — 이진 탐색 시작점
  }
  export fn append(e) {
    role: 메모리 + jsonl 한 줄 (동기 write — 순서 보장)
  }
  export fn updateMeta(patch) {
    role: vendorSessionId·title·updatedAt·closedAt 등 갱신 (tmp 뒤 rename)
  }
  export fn storedInfo() -> SessionInfo {
    role: 저장만 된 세션의 SessionInfo — state exited·live false
  }
}
export fn unrewound(events) -> LoggedEvent[] {
  role: turn.rewound 가 버린 턴(그 seq 부터)을 뺀 이벤트 — 대화 되돌리기의 유지 지점과 다시 import 의 기준을 찾을 때
}
export fn visible(events) -> LoggedEvent[] {
  role: 화면에 남는 이벤트 — turn.rewound 가 버린 턴을 빼되 tool.end·approval.resolved 는 남긴다(앞 턴의 카드를 닫는다). 웹 replayHistory 의 규칙과 같다 (ticket slcode-history-paging)
}
export fn historyPage(events, before, limit) -> HistoryPage {
  role: 기록 페이지 — visible 의 seq before 앞에서, 끝부터 화면 항목(이어진 같은 범위의 delta 는 하나) limit 개 안의 가장 앞 자름 지점, 없으면 그 너머 첫 지점에서 자른다. 자름 지점은 열린 tool·approval·task 가 없는 turn.start (웹 pickCut 과 같다) — session.exit 에서 열린 것을 비운다(벤더가 끝나 끝 이벤트가 오지 않는다). 지점이 없으면 전부
}
export fn summarize(events) -> HistorySummary {
  role: 기록 전체(되돌린 턴 포함)의 turn.end 사용량·비용 누계(SDK 비용은 프로세스 누계라 줄어드는 경계에서 기준선에 합친다), 훅 횟수·마지막, 마지막 session.ready — 웹이 앞 페이지를 안 받고도 합계를 그린다
}
type SessionMeta
