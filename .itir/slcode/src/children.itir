import { connectSession, BUILD, PKG } from './client'
import { spawnCore, sockAlive } from './live'
import { EventLog } from './eventLog'
import { CoreError, ERR } from './protocol'
import { sessionMeta } from './mail'

role: 리더 core 쪽 팀원 세션 (ticket slcode-team-agent — slcode-subagent-sessions 의 자식 세션을 이었다). 리더 core 가 팀원 core 를 spawnCore 로 띄운다(meta.team 에 관여 옵션). link 팀원(meta.parent {id: 리더, kind: child})은 그 소켓에 연결 하나를 붙여 소유한다 — core.own {parent: true, follows: true}. link 가 꺼진 팀원은 띄우기만 하고 붙지 않는다(소유자 없이 사는 보통 세션). 수명: 리더가 닫히면 closeAll 이 endWithLeader 팀원은 닫고 나머지는 연결만 놓는다. 리더 프로세스가 죽으면 연결이 끊겨 endWithLeader 팀원은 소유자 유예 뒤 닫히고 나머지는 산다(팀원 core 가 정한다). 카드·웹은 자식을 보기만 한다. 같은 연결에 session.attach 를 걸어 자식의 대기 승인을 들고(부모 화면이 "서브 <이름>" 승인 줄로 보인다, 3A), 지시(send·interrupt·approve·close)는 이 연결로 중계한다 — 자식 core 는 잠긴 동안 이 연결의 요청만 받는다. 자식 core 가 교체되면(core.replaced) 다시 붙어 소유권을 다시 잡는다. 붙을 때 자식 core 가 이 부모보다 옛 빌드면 core.retire {pkg: PKG} 로 이 판으로 바꾼다(serve 교체가 메인에만 청하던 엣지). 부모 core 가 교체로 새로 뜨면 adoptLive 가 켜진 자식을 takeover 로 다시 소유한다 — 사람이 따로 소유한 자식(부모 없이 resume)은 자식 core 가 거절해 그대로 둔다. 자식이 부모의 요청 없이 끝나면 exited 로 알린다(부모 core 가 메시지로 모델에 알린다). 교체로 내려가는 부모는 release 로 알림 없이 놓는다. 답하면 닫힘 팀원이 스스로 닫힌 것(사유 ANSWERED)은 알리지 않고, 리더가 다시 시키면 reopen 이 resume 으로 다시 띄워 소유한다(닫히는 중이면 연결이 끝나기를 기다린 뒤). 연결이 끝날 때마다(교체로 다시 붙는 것 빼고) gone 으로 알려 리더 core 가 그 팀원의 답을 기다리던 요청을 푼다. worktree 팀원(ticket slcode-team-worktree): reopen 은 meta.worktree.removedAt 이 있으면(clean-worktree 로 지웠다) 다시 띄우지 않고 bad_request 로 거절한다. 리더가 닫힐 때 cleanWorktrees 가 이 리더의 cleanWithLeader 팀원 worktree 를 — 켜진 팀원은 닫히기를 잠시 기다린 뒤 — 잃을 작업이 없을 때만 지우고 removedAt 을 남긴다(잃을 작업이 있거나 아직 켜져 있으면 남기고 로그만). 리더 프로세스가 죽으면 지우지 않는다(남는다).

export class Children {
  role: 리더 core 하나의 팀원 표 — spawn(새 팀원, link 면 소유)·reopen(답하고 닫힌 이 리더의 link 팀원을 다시 띄워 소유)·has·adoptLive(기동 때)·call(소유 연결로 중계, close 면 기대한 종료로 표시)·pendingOf·list(화면용 {id, title, state, pending} — state 는 붙을 때의 상태에서 팀원의 session.state 를 따라 바뀌고, 리더 화면의 입력창 위 "실행 중" 줄이 센다)·closeAll(endWithLeader 는 닫고 나머지는 놓는다)·cleanWorktrees(리더가 닫힐 때 cleanWithLeader 팀원의 worktree 를 잃을 것이 없으면 지운다)·release
}

export val ANSWERED
export type SpawnOptions
export fn teamOf(meta) -> TeamOptions? {
  role: 세션의 관여 옵션(meta.team) — 팀원이 아니면 null. meta.team 없는 옛 실험 자식은 보통 세션
}
export fn teamOptionsError(o) -> String? {
  role: 관여 옵션 오류 사유 — 모르는 키, 불리언이 아닌 값, link 없이 켠 리더 옵션(inputControl·outputToLeader·askToLeader·endWithLeader·endWithAnswer·cleanWithLeader), endWithLeader 없이 켠 cleanWithLeader. 맞으면 null
}
val TEAM_KEYS
