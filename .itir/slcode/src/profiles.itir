import { parseAssignment, readManifest } from '../slcode-plugin/src/agentFormat'
import { agentPaths, locked, readConfig, writeConfig, AgentConfig, PluginLayer } from '../slcode-plugin/src/agentPlugins'

role: 세션 시작 프로필 (ticket slcode-session-profile, 사용자 결정 2026-10-28 — ws docs/ticket/slcode-session-profile/TICKET.md). 새 세션을 띄울 때 고른다(`slcode new --profile <이름>`·slcode.new 동사 --profile, 생략하면 default). 세션 meta.profile 에는 이름만 남기고(default 는 남기지 않는다) 띄울 때마다(resume·core 교체 포함) 그 프로필의 지금 값을 읽는다 — 프로필을 고치면 그 프로필로 띄우는 다음 기동부터, 지운 프로필이면 default 로 띄우고 알린다. 프로필이 정하는 것: 실을 slcode 에이전트 플러그인(플러그인별 on, 정하지 않은 것은 rest)과 그 part·옵션 값(설정 값 층 기본 설정 < 프로필 < 세션), Claude 가 사용자(~/.claude)·프로젝트 설정을 읽을지·CLAUDE.md 만 따로 뺄지·Claude 내장 skill 을 숨길지. 기본 제공 default(전부)·bare(플러그인·설정·내장 skill 없음)는 config.json 에 없고 고칠 수 없다. 사용자 프로필은 config.json 의 profiles(agentPlugins 의 잠금·쓰기를 쓴다). Codex 는 실을 플러그인과 그 값만 따르고 claude.* 에 해당하는 것은 없다 — 사용자 설정을 막을 옵션이 없고(-c mcp_servers={} 로도 사용자 MCP 가 남는다, 0.159 실측), pi 계열로 가기 전의 중간 단계라 우회책(가짜 CODEX_HOME + auth.json·sessions 링크 + CODEX_SQLITE_HOME — 동작은 실측으로 확인)을 두지 않는다 (사용자 2026-10-28).

type ClaudeLoadSpec
type Profile
type ProfileRow
export fn profileSummary(p) -> String {
  role: 화면(시작 화면·대화 화면의 프로필 고르기)에 보이는 한 줄 — 실을 플러그인 · Claude 사용자·프로젝트 설정(CLAUDE.md 끔) · 내장 skill 숨김. CLI 의 profile list 는 영어 세 줄(cli describeProfile)
}
type ClaudeLoad
export val DEFAULT_PROFILE
export val BUILTIN_PROFILES
export fn getProfile, listProfiles
export fn sessionProfile(name, stateDir) {
  role: meta 의 이름(없으면 default)으로 — 없는 프로필이면 default 와 missing(원래 이름)
}
export fn addProfile(name, from, stateDir, assignments) {
  role: from(기본 default)의 값을 복사해 사용자 프로필을 만들고 assignments(setProfile 과 같은 꼴, assign)를 얹는다 — 고르기 화면의 새 프로필이 한 번에 만든다(사용자 2026-10-30). 기본 제공 이름·있는 이름·틀린 값이면 아무것도 만들지 않고 던진다
}
export fn removeProfile(name, stateDir) {
  role: 없으면 removed false. 기본 제공은 던진다
}
export fn setProfile(name, assignments, stateDir) {
  role: `<플러그인>=on|off`, `<플러그인>.<part>=on|off`, `<플러그인>.<옵션>=<값>`(그 플러그인의 manifest 로 parseAssignment), `other-plugins=on|off`(rest), `claude.user|project|user-md|project-md|builtin-skills=on|off`. 설치하지 않은 플러그인 이름이면 던진다. 하나라도 틀리면 아무것도 바꾸지 않는다
}
export fn claudeLoad(c, cwd, env, plugins) -> ClaudeLoad {
  role: 프로필의 Claude 쪽을 SDK 옵션으로 (SDK 0.3.282 실측 2026-10-28, 격리 HOME·가짜 API). settingSources — user 를 빼면 ~/.claude 의 CLAUDE.md·skill·플러그인·훅·권한과 ~/.claude.json 의 MCP 가, project 를 빼면(local 도 함께) 프로젝트 CLAUDE.md·.claude/skills·.mcp.json 이 빠지고 inline 으로 실은 slcode 플러그인은 남는다. claudeMdExcludes(플래그 settings) — skill·MCP 는 두고 CLAUDE.md 만 뺀다: 사용자 것은 <설정 폴더>/CLAUDE.md·rules/**, 프로젝트 것은 cwd 아래 전부와 cwd 에서 / 까지 조상의 CLAUDE.md·CLAUDE.local.md·.claude/CLAUDE.md·.claude/rules/**(조상의 .claude 가 사용자 설정 폴더면 그 안은 남긴다). skills 허용 목록 — 내장 skill 을 숨길 때만: 실은 slcode 플러그인의 <플러그인>:<skill> 과 켠 출처의 skills/ 디렉터리 이름. SDK 는 그 밖의 skill 을 모델 요청에서 빼지만 init 목록에는 남긴다(ClaudeSession 이 거른다). ~/.claude 에 설치한 Claude 플러그인의 skill 은 미리 알 수 없어 함께 숨겨진다. env — claude.ai 계정의 MCP 커넥터(Gmail·Drive 등)는 settingSources 와 상관없이 실려(실측) 사용자 설정을 끄면 ENABLE_CLAUDEAI_MCP_SERVERS=false 를 함께 준다. strictMcpConfig 는 slcode 플러그인 MCP 까지 빼므로 쓰지 않는다
}
fn assign(p, assignments, c, ap) -> Profile {
  role: setProfile·addProfile 이 같이 쓰는 값 얹기 — p 를 바꾸고, 틀린 값이면 던진다(부르는 쪽이 쓰기 전이라 아무것도 남지 않는다)
}
fn editable(name) {
  role: 기본 제공이면 던지고 이름 꼴(NAME)을 본다
}
