import { FILES } from './protocol'

role: 파일 위치 — $SLCODE_DIR(격리·테스트; 옛 $AGENT_CORE_DIR 은 한 버전 폴백) 또는 ~/.local/state/slcode. 2026-10-02 개명 전 세션은 옛 ~/.local/state/agent-core 에 그대로 두고 함께 찾는다 (이주 없음, 사용자 결정 2026-11-04 — 1.0.0 에서 지운다, ticket slcode-remove-legacy-state-dir). 새 세션과 그 밖의 상태는 새 폴더다. core.log(core 프로세스들의 stderr — serve 가 detached 로 띄울 때 잇는다)·slcode.token(웹을 루프백 밖으로 열 때)·sessions/<cwd 슬러그>/<id>/(meta.json·events.jsonl·sock). cwd 슬러그는 claude 규칙(영숫자·- 밖은 -) — 평탄 구조 기각 (사용자 결정 2026-09-27, 수천 세션 전제). 디렉토리 0700·소켓 0600 이 UDS 의 인증

export fn coreDir() -> Path {
  role: 기본 디렉토리
}
export fn corePaths(dir) -> CorePaths {
  role: coreLog·token·sessionsDir 경로 묶음. 옛 기본 폴더를 주면(옛 core 가 교체하며 넘긴다) 새 기본 폴더로 읽는다
}
export fn sessionRoots(sessionsDir) -> Path[] {
  role: 세션을 찾을 sessions 폴더들 — 기본 폴더면 옛 폴더까지, 지정한 폴더(--dir·$SLCODE_DIR)는 그 폴더만. 1.0.0 에서 지운다
}
export fn stateFile(dir, name) -> Path {
  role: 읽을 상태 파일 — 기본 폴더에 없고 옛 폴더에 있으면 옛 폴더의 것 (설정·토큰). 쓰기는 새 폴더. 1.0.0 에서 지운다
}
export fn cwdSlug(cwd) -> Text {
  role: /a/b.c_d → -a-b-c-d
}
export fn sessionDir(sessionsDir, cwd, id) -> Path {
  role: sessions/<슬러그>/<id>
}
export fn ensureDir(dir) {
  role: 0700 으로 만든다
}
export fn readOrCreateToken(p) -> Text {
  role: 있으면 재사용(브라우저 localStorage 의 토큰이 재기동 뒤에도 유효), 없으면 24바이트 hex 를 0600 으로
}
