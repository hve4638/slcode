import { ActivityAgentState, ActivityRecord, ActivityResult, FILES } from './protocol'

role: 활동 기록 (ticket slcode-activity-state, 사용자 결정 2026-10-25~27 — 프로토타입으로 정함). 세션 하나에서 사람과 에이전트가 주고받는 흐름을 남기고 구간으로 판정한다. 원자료는 세션 폴더의 activity.jsonl 에 한 줄씩 — 에이전트 상태 변화(session.state 를 running·asking·idle·exited 넷으로 접는다: starting 은 idle, requires_action 은 asking), 점(요청 보냄 = 사람이 보낸 session.send — origin 이 있는 턴·첫 프롬프트 인자는 아니다; 질문 답변함 = session.approve 가 처리한 것), 화면 신호(session.signal — 약한·강한, 무엇). 시각은 core 의 시계. 이벤트 로그(events)에는 섞지 않는다(attach 재생이 무거워진다). 세션이 꺼질 때 exited 를 적고, core 교체는 handoff 로 적어 이어진 것으로 본다. 기동 때 마지막 기록이 exited·handoff 가 아니면(크래시) 그 시각에 exited 를 적는다 — slcode 가 꺼져 있던 시간도 세션 꺼짐이다(사용자 결정: 둘을 합친다). 판정은 classify 하나(순수 함수) — 판정 규칙을 고쳐도 지난 기록을 다시 계산할 수 있다. 포커스·마우스 움직임은 보지 않는다. 사람 쪽은 사용자 차례(idle·asking) 동안 확인 중 또는 AFK 둘뿐이다. 기능 이전의 세션은 기록이 없다(그 뒤부터 쌓인다). THRESHOLDS 문턱값 (사용자 결정 2026-10-25) — afkAfter 20분: 마지막 신호 뒤 이만큼 신호가 없으면 AFK 확정; afkLead 5분: AFK 시작은 마지막 신호 + 이만큼으로 거슬러 적는다; weakWindow 1분·weakCount 3: AFK 중 이 창 안의 약한 신호 이 수면 해제(1분이 지난 약한 신호는 버리고 잠깐 확인 점으로); cancelWithin 1분: 약한 신호로 풀린 뒤 이 안에 다시 AFK 면 해제를 없던 것으로 한다

export val THRESHOLDS
export fn classify(records, now, th) -> ActivityResult {
  role: 원자료 → 에이전트 구간(running·asking·idle·exited) · 사람 구간(active 확인 중·afk) · 점(sent·answered) · 잠깐 확인(peeks) · 지금 상태. 자리 비움은 에이전트 상태와 무관하게 신호만으로 계산하고(응답 대기 중에도 센다, 메시지 턴처럼 사람 아닌 일은 신호가 아니다), 사람 구간은 사용자 차례를 자리 비움으로 잘라 만든다. 점(보냄·답변)은 강한 신호이기도 하다. AFK 해제 시각은 해제 묶음의 첫 신호 — 강한 신호 하나 또는 weakWindow 안 약한 신호 weakCount 번. 낙관 표시(약한 신호 하나에 바로 확인 중)는 하지 않는다(사용자 결정 2026-10-27)
}
export fn clip(r, from) -> ActivityResult {
  role: from 뒤에 걸친 구간과 점만 — 사이드바는 최근 1시간만 받는다
}
export class Activity {
  role: 세션 하나의 활동 기록 — 열 때 activity.jsonl 을 읽어 메모리에 두고(깨진 줄은 건너뛴다) 기록마다 파일 끝에 덧붙인다. open 이 크래시 꼬리(exited 없음)를 고친다. agent(state)·sent()·answered()·signal(strength, what)·exited()·handoff() 로 적고, result(from?) 로 지금 시각의 classify(·clip) 를 낸다. 같은 에이전트 상태가 이어지면 적지 않는다. 신호의 what 은 영숫자·- 32자까지
}
