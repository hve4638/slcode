import { CoreError, isEvent } from './protocol'

role: JSON 줄 RPC 클라이언트 — 세션 소켓(sessions/<슬러그>/<id>/sock, Methods)에 붙는다. 세션 소켓은 띄우지 않는다 — core 는 serve 가 띄운다 (serve.spawnCore)

export val PKG
export val VERSION
export val BUILD
export fn diskBuild() {
  role: 지금 디스크에 있는 이 설치의 {version(package.json), build(dist/cli.js 의 mtime ms — 같은 버전을 다시 빌드해도 바뀐다, 없으면 0)}. 떠 있는 프로세스의 VERSION·BUILD(뜰 때의 값)와 견줘 새 코드가 깔렸는지 안다 — serve 의 update.run 과 `slcode --version --json` (ticket slcode-core-serve-split 2단계)
}
export class RpcClient {
  role: 타입 있는 요청 id 매칭·이벤트 구독·닫힘 프로미스 done. 소켓은 utf8 로 디코드한다 — 큰 응답(attach 의 긴 기록)에서 청크 경계의 한글이 깨지지 않게 (분리 전부터 있던 버그, 2026-10-15). 끊기면 대기 요청은 closed 로 거절하고 disconnected 를 이벤트로 흘린다
  export fn request(method, params) -> result {
    role: 타입 매칭 요청
  }
  export fn onEvent(h) {
    role: 이벤트 구독 — 해제 함수
  }
  export fn close() {
    role: 소켓 end
  }
}
export fn connectSession(sockPath) -> RpcClient {
  role: 세션 소켓에 붙는다 — 없으면 no_session. 그 소켓이 교체 중이면(replacingMark 의 기한 안) 새 core 가 소켓을 열 때까지 100ms 간격으로 다시 붙어 본다 — CLI 동사·serve 의 재접속이 모두 이 길 (ticket slcode-core-serve-split 3단계, 사용자 2026-10-19: 재시도는 공용 연결에). 표시가 없으면 기다리지 않는다 — 꺼진 세션의 오류가 늦어지지 않게
}
export fn connectSock(sockPath) -> Socket {
  role: connectSession 과 같은 기다림으로 맨 소켓 — serve 의 중계 연결이 프레임을 해석하지 않고 다시 붙는다
}
export fn replacingMark(sockPath) -> path {
  role: 교체 중 표시 파일 — 소켓 경로 옆 <sock>.replacing, 내용은 기한(ms). 내리는 core 가 쓰고 지운다
}
export fn replacing(sockPath) -> Bool {
  role: 표시가 있고 기한이 지나지 않았는가
}
