role: Claude system prompt 편집의 블록 맞추기·조립 (ticket slcode-profile-system-prompt, 사용자 결정 2026-11-17 — ws docs/ticket/slcode-profile-system-prompt/TICKET.md). 프로필은 Claude Code 의 기본 프롬프트를 블록 단위로 끄고·고치고·나누고 사이에 글을 더한다. 설정은 원문과 따로 해시로 가리킨다(원문은 promptLibrary 의 판에 함께 저장한다 — ticket slcode-prompt-library, 다시 가져온 원본에도 같은 블록이면 설정이 이어진다). 받은 프롬프트(promptCapture)를 줄로 쪼개고, 블록은 연속한 줄 몇 개이며 첫 줄 해시(head)·줄 수(lines)·전체 해시(hash)로 가리킨다. 첫 줄 해시로 시작 자리를 찾고 전체 해시가 맞으면 그 블록의 설정을 적용한다. 맞지 않는 줄은 받은 글 그대로 나간다 — Claude Code 가 한 블록의 글을 바꾸면 그 블록의 설정만 풀리고(사용자에게 따로 알리지 않는다, 사용자 2026-11-17), 배열 블록 통째 해시 + 글자 오프셋 안은 문장 하나에 그 배열 블록의 설정이 모두 풀려 버렸다. 해시는 세션마다 다른 값(메모리 경로·설정 폴더·작업 폴더·홈)을 자리표시로 바꾼 뒤 잰다. 미리 나눠 둔 블록과 설명(promptPieces)은 같은 방식으로 맞는 것에만 씌우는 보조다 — 그 표의 off(처음 가져올 때 끌 블록)는 segment 가 입히지 않는다. 블록은 뜻 단위 — 문장·단어 단위로 쪼개지 않는다.

type PromptPiece
type PromptAdded
type PromptSpec
type PromptItem
type Norm
type EditedItem
export fn normalizer(p) -> Norm {
  role: 메모리 경로(<설정 폴더>/projects/<폴더 슬러그>)·설정 폴더·작업 폴더·홈을 자리표시로 바꾸는 함수 — 긴 것부터
}
export fn normOf(env, cwd, home) -> Norm
export fn pieceKey(text, norm) {
  role: 블록 글의 세 값 — 첫 줄 해시(8자)·줄 수·전체 해시(16자)
}
export fn segment(blocks, spec, builtin, norm) {
  role: 받은 배열 블록들을 화면·조립이 함께 쓰는 줄로. 줄마다 저장된 블록(spec)을 먼저, 그다음 미리 나눠 둔 블록(builtin)을 맞춘다 — 사용자가 나눈 블록이 우리 것보다 먼저다. 맞는 것이 없으면 제목 줄(# …)은 제목 줄로, 나머지는 다음 맞는 블록·제목 줄 전까지 한 덩어리(known null). 빈 줄은 다음 줄의 gap. 더한 글은 앞 블록(after, 제목 줄도 된다) 바로 뒤에 저장된 순서로, 앞 블록이 없어졌으면 맨 끝에
}
export fn compose(items, blocks) {
  role: 줄들을 배열 블록별 글로 — 끈 것·빈 글은 빼고 고친 것은 고친 글로. 제목 줄은 다음 제목 줄 전에 나가는 글이 있을 때만 나간다. 아무것도 바꾸지 않았으면 받은 글과 글자까지 같다(전역 캐시 자리)
}
export fn cleanSpec(v) {
  role: 디스크·화면에서 온 값을 PromptSpec 으로 — 꼴이 아니거나 비었으면 undefined (없음 = 기본 프롬프트)
}
export fn sameSpec(a, b) -> Bool
export fn specOf(edited, norm) {
  role: 편집 창의 줄들(받은 글 그대로 + 화면에서 정한 것)을 저장할 꼴로 — 블록은 끄거나 고치거나 사용자가 나누고 합쳐 만든 것(user)만 남긴다. 더한 글의 after 는 바로 앞 블록·제목 줄의 해시
}
