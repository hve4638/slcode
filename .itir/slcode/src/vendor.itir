import { Vendor } from './protocol'

role: 벤더 하네스(Claude Code·Codex)가 직접 저장한 세션 찾기 (ticket vendor-import, 사용자 2026-10-07) — `slcode import`·`export` 가 쓴다. claude 는 $CLAUDE_CONFIG_DIR(기본 ~/.claude)/projects/<슬러그>/<id>.jsonl, 슬러그는 되돌릴 수 없어 줄의 cwd 필드에서 폴더를 읽는다. codex 는 $CODEX_HOME(기본 ~/.codex)/sessions/**/rollout-*-<id>.jsonl 첫 줄 session_meta.payload.cwd. 기록은 클 수 있어 앞·뒤 1MB 만 읽는다

export fn findVendorSession(id, vendor) -> VendorSession? {
  role: 벤더 세션 id 로 기록 파일·폴더를 찾는다. vendor 를 주면 그쪽만, 없으면 claude 먼저. 영숫자·- 밖 글자가 든 id 는 거절(경로 조각 방지)
}
export fn claudeLastUuid(file) -> String? {
  role: Claude 기록의 마지막 대화 항목(user·assistant, 서브에이전트 곁가지 isSidechain 제외) uuid — 가져온 세션의 첫 턴 되돌림 유지 지점
}
export fn forkClaude(id, cwd) -> String {
  role: Agent SDK forkSession({dir: cwd}) 으로 Claude 세션을 갈라 새 세션 id — 원본은 그대로, uuid 는 새로 매겨지고 file-history 는 따라오지 않는다 (사용자 2026-10-07: 기록 파일 복사 대신 벤더 복제 기능)
}
export fn vendorResumeCommand(vendor, cwd, id) -> String {
  role: `cd '<폴더>' && claude --resume <id>` 또는 `codex resume <id>` 한 줄 (폴더는 홑따옴표)
}
type VendorSession
