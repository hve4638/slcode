import { buildId, frontmatter, partLost, valuesString, walk, Harness, Manifest, Resolved } from './agentFormat'

role: 에이전트 플러그인의 하네스별 빌드 (ticket slcode-agent-plugin) — 지금은 Claude 만(Codex 는 slcode-agent-plugin-codex, GPT 하네스는 그 하네스 ticket). 원본에서 단방향으로 만들고 폴더 이름은 빌드 식별자. 켠 part 를 parts 순서로 합친다: part 마다 바깥 항목을 먼저 놓고 raw/claude/ 를 겹친다(raw/ 의 다른 폴더는 무시). hooks/hooks.json 은 이벤트별로 잇고, .mcp.json 은 서버 이름별로 합치고(같은 이름은 뒤가 이긴다, mcpServers 꼴과 평평한 꼴 둘 다 받는다), 그 밖의 겹친 경로는 뒤의 것. 문법이 깨진 hooks.json·.mcp.json·session.json·plugin.json 은 그 파일만 뺀다 — 빌드 에러는 없다. 형식이 따로 다루지 않는 part 파일(훅·MCP 가 부르는 스크립트 등)은 그대로 플러그인 폴더에 들어간다(Claude 가 모르는 것은 Claude 가 무시한다 — 빼면 ${CLAUDE_PLUGIN_ROOT}/scripts/… 를 부르는 훅이 깨진다). 덮어쓴 것·뺀 것·하네스가 못 받는 것·지시문 판단은 report.json 에. BUILD_FILES 는 build/<식별자>/ 아래 이름 — report.json, instructions.md(합친 지시문, 경로 변수는 그대로 두고 싣는 쪽이 바꾼다 — 세션마다 링크 경로가 다르다), session.json(raw/claude/session.json, 뒤 part 가 이긴다).

type Report
export val BUILD_FILES
export fn buildClaude(src, m, r, id, out) -> Report {
  role: out/claude/<이름>/(플러그인 폴더 — .claude-plugin/plugin.json 은 raw/claude 의 것에 name·version 을 manifest 값으로, bin/ 실행 비트 유지)·instructions.md·session.json·report.json 을 쓴다. 지시문은 바깥 instructions/*.md 만, if 가 참인 것을 part 순서·파일 이름 순서로 잇는다
}
fn ifFalse(m, r, cond) -> Text? {
  role: if 가 없으면 싣는다. boolean 옵션이 아닌 이름이면 싣지 않고 사유
}
export fn ensureBuild(buildDir, src, m, r, hash, harness) {
  role: 그 식별자의 빌드(report.json)가 있으면 mtime 만 새로 하고 다시 쓴다, 없으면 .tmp-<임의> 에 빌드한 뒤 rename — 동시에 둘이 빌드하면 먼저 놓인 것을 쓴다
}
