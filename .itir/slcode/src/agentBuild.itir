import { buildId, frontmatter, mcpTransport, partLost, valuesString, walk, Harness, Manifest, Resolved } from './agentFormat'
import { buildPartHooks, CODEX_EVENTS, partCommandHooks, ScriptEntry } from './agentHooks'

role: 에이전트 플러그인의 하네스별 빌드 (ticket slcode-agent-plugin) — Claude 와 Codex(slcode-agent-plugin-codex, 최소 지원: skill·MCP·지시문·bin·env). GPT 하네스는 그 하네스 ticket. 원본에서 단방향으로 만들고 폴더 이름은 빌드 식별자. 켠 part 를 parts 순서로 합친다: part 마다 바깥 항목을 먼저 놓고 raw/claude/ 를 겹친다(raw/ 의 다른 폴더는 무시). hooks/hooks.json 은 이벤트별로 잇고, .mcp.json 은 서버 이름별로 합치고(같은 이름은 뒤가 이긴다, mcpServers 꼴과 평평한 꼴 둘 다 받는다), 그 밖의 겹친 경로는 뒤의 것. 문법이 깨진 hooks.json·.mcp.json·session.json·plugin.json 은 그 파일만 뺀다 — 빌드 에러는 없다. 형식이 따로 다루지 않는 part 파일(훅·MCP 가 부르는 스크립트 등)은 그대로 플러그인 폴더에 들어간다(Claude 가 모르는 것은 Claude 가 무시한다 — 빼면 ${CLAUDE_PLUGIN_ROOT}/scripts/… 를 부르는 훅이 깨진다). 덮어쓴 것·뺀 것·하네스가 못 받는 것·지시문 판단은 report.json 에. BUILD_FILES 는 build/<식별자>/ 아래 이름 — report.json, instructions.md(합친 지시문, 경로 변수는 그대로 두고 싣는 쪽이 바꾼다 — 세션마다 링크 경로가 다르다), session.json(raw/claude/session.json, 뒤 part 가 이긴다), codex-args.json(Codex 빌드의 app-server 인자). js/ts 훅(ticket slcode-agent-plugin-hooks): 바깥 hooks/hooks.json 은 slcode 형식이라 agentHooks.buildPartHooks 가 읽는다 — command 항목은 Claude 형식으로 잇고, script 는 묶어 scripts.json 에(Claude 에 넘기지 않는다), 묶지 못한 것은 report.scripts.failed. raw/claude/hooks/hooks.json 은 Claude 형식 그대로. Codex 빌드는 훅을 싣지 않는다. 상수 — BUILD_FILES: build/<식별자>/ 아래 이름 — report.json, instructions.md, session.json, codex-args.json, codex-mcp.json·codex-hooks.json(Codex export 가 플러그인의 .mcp.json·hooks/hooks.json 으로 쓴다 — slcode 의 Codex 세션은 쓰지 않는다, ticket slcode-agent-plugin-export), scripts.json(js/ts 훅 스크립트 목록 [{src, js}] — 묶은 것은 scripts/<번호>.mjs, ticket slcode-agent-plugin-hooks).

type Report
export val BUILD_FILES
export fn buildClaude(src, m, r, id, out) -> Report {
  role: out/claude/<이름>/(플러그인 폴더 — .claude-plugin/plugin.json 은 raw/claude 의 것에 name·version 을 manifest 값으로, bin/ 실행 비트 유지)·instructions.md·session.json·report.json 을 쓴다. 지시문은 바깥 instructions/*.md 만, if 가 참인 것을 part 순서·파일 이름 순서로 잇는다
}
fn ifFalse(m, r, cond) -> Text? {
  role: if 가 없으면 싣는다. boolean 옵션이 아닌 이름이면 싣지 않고 사유
}
export fn buildCodex(src, m, r, id, out, root, data) -> Report {
  role: Codex 빌드 — out/codex/(플러그인 폴더: skills/·bin/·그 밖의 part 파일), instructions.md, codex-args.json, report.json. 켠 part 를 parts 순서로, 겹친 경로는 뒤의 것. hooks/hooks.json·raw/ 는 slcode 의 Codex 세션에 싣지 않는다(partLost 가 report.lost 에 적는다) — export 용으로 command 훅 중 Codex 가 받는 이벤트(CODEX_EVENTS)만 ${slcode.vars.harness}=codex·경로 변수를 바꿔 codex-hooks.json 에(못 싣는 항목은 그 excluded 에) — SessionEnd·Interrupt 의 timeout 은 3초를 넘지 않게(Codex 가 줄이면서 매번 경고를 낸다, 0.165 실측), MCP 는 이름을 바꾼 서버 정의를 codex-mcp.json 에도. Codex 는 경로 변수를 모르므로 모든 텍스트 파일(NUL 이 없는 것)·지시문·MCP 정의에서 ${CLAUDE_PLUGIN_ROOT} 는 root(그 플러그인 폴더가 놓일 경로 — 세션 빌드는 rename 뒤의 빌드 폴더/codex: 빌드는 세션 사이에 나눠 쓰므로 세션 링크 경로를 박을 수 없다. Codex export 는 export 링크), ${CLAUDE_PLUGIN_DATA} 는 data(상태 폴더 data/<이름> — Claude 와 따로 둔다, 설계) 로 바꾼다. skill 은 codexSkill 로. .mcp.json 은 서버 이름별로 합쳐(뒤가 이긴다) stdio 는 command·args·env·cwd, http 는 url·http_headers 로 바꿔 `-c mcp_servers.plugin_<플러그인>_<서버>=<TOML 인라인 표>` 인자로(이름의 [A-Za-z0-9_-] 밖은 _) — 다른 연결 방식은 빼고 partLost 가 적는다. Claude 의 ${VAR} env 치환은 하지 않는다
}
export fn codexSkill(text, folder) {
  role: Claude skill → Codex skill. Codex 는 frontmatter 가 없으면 싣지 않는다(missing YAML frontmatter, 2026-10-28 실측) — name(없으면 폴더 이름)·description(없으면 본문의 첫 줄, # 을 벗긴다; when_to_use 는 공백으로 뒤에) 두 필드만의 frontmatter 로 다시 쓴다(값은 JSON 문자열 = YAML 큰따옴표). 그 밖의 필드는 버린다 — Codex 는 무시한다(실측). disable-model-invocation: true 면 agents/openai.yaml 의 policy.allow_implicit_invocation: false(모델에 가는 skill 목록에서 빠진다, 실측)
}
fn toml(v) -> Text {
  role: JSON 값 → TOML 인라인 값(-c 의 값은 TOML 로 읽힌다) — 문자열·키는 JSON 따옴표(TOML basic string 과 이스케이프가 같다), null 인 키는 뺀다
}
export fn ensureBuild(buildDir, src, m, r, hash, harness) {
  role: 그 식별자의 빌드(report.json)가 있으면 mtime 만 새로 하고 다시 쓴다, 없으면 .tmp-<임의> 에 그 하네스의 빌드(codex 면 buildCodex — data 는 buildDir 옆 data/<이름>, 아니면 buildClaude)를 쓴 뒤 rename — 동시에 둘이 빌드하면 먼저 놓인 것을 쓴다
}
