import { ApprovalRequest, Attachment, CoreEvent } from './protocol'
import { EventLog, unrewound } from './eventLog'
import { AgentSession } from './base'
import { SLCODE_PROMPT } from './prompt'

role: Claude 어댑터 — 세션 하나 = SDK query() 하나 (streaming input AsyncQueue, 상시 프로세스, t3code ClaudeAdapter 와 같은 꼴). SDK 메시지를 벤더 중립 CoreEvent 로 정규화해 EventLog 에 남기고 구독자에게 낸다. 옵션: 슬래시 명령의 로컬 출력(/context·/cost 등)은 local_command_output 또는 model '<synthetic>' 인 assistant 메시지(스트림 없음)로 온다 — 둘 다 text.delta 로 내어 답변처럼 보인다. 단 error 칸(SDKAssistantMessageError)이 붙은 본문 assistant 메시지는 답변이 아니라 그 턴의 실패 사유다 (인증 실패 "Not logged in · Please run /login"·API 오류, 2026-10-15 실측) — text.delta 로 내지 않고 result 때 turn.end(ok false, error 는 그 synthetic 문구, errorKind 는 authentication_failed·api_error_status 401 이면 'auth') 로 옮긴다. 성공 판정은 subtype success 이고 is_error·error 칸이 둘 다 없을 때만 — 인증 실패도 subtype 은 success 다 (ticket slcode-auth-error-shown-as-answer). includePartialMessages(델타)·includeHookEvents·forwardSubagentText(서브에이전트 텍스트는 완성 블록으로 와서 델타 하나로 낸다)·agentProgressSummaries(task progress 의 한 줄 요약)·systemPrompt preset claude_code·settingSources user/project/local(CLI 와 같은 로드 — 스파이크 (a) 실측)·resume(벤더 세션 id — 벤더 CLI --resume 과 양방향 호환, 2026-09-26 실측)·resumeSessionAt(rewind 의 유지 지점)·enableFileCheckpointing(rewindFiles 용)·env(CLAUDE_* 를 뺀 것에 IS_SANDBOX=1 을 늘 얹는다 — uid 0 이면 CLI 가 IS_SANDBOX=1(값 '1' 만) 없이는 allowDangerouslySkipPermissions 의 --allow-dangerously-skip-permissions 나 bypass 모드만으로 첫 턴 전에 exit 1 한다(CLI 2.1.282, 2026-10-08 실측). root 에서도 bypass 를 쓰게 Claude Code 의 이 안전 장치를 slcode 가 끈다 — 사용자 결정 2026-10-09). 사용자 메시지 uuid 는 우리가 정해 보낸다(SDK submitMessage options.uuid 자리) — turn.end 에 userUuid·마지막 uuid 를 싣는다. 상태 파생: turn.start→running, approval.requested→requires_action, 마지막 승인 해소→running, result→idle, 벤더 기동(생성자에서 run 시작) 직후→idle — Claude 의 init 은 첫 프롬프트 뒤에야 와서 그 전도 보낼 수 있는 상태다. 첫 턴도 idle 에서 보내므로 running 을 거친다 (ticket slcode-first-turn-shows-idle, 사용자 결정 2026-10-17: 프롬프트 전은 시작 중 대신 대기). 승인은 무기한 대기 (사용자 결정 2026-09-26) — interrupt·close·프로세스 종료만 cancelled 로 푼다. raw 켜면 이벤트마다 SDK 원문을 raw 필드에 싣는다 시스템 프롬프트: Claude Code preset 에 slcode 고정 지시(SLCODE_PROMPT)를 append 한다 (ticket slcode-append-system-prompt) — snapshot 은 SDK 기본(첫 요청 때 기록, resume 도 그 기록)을 그대로 둬 기존 세션은 compact 뒤부터 들어가고 캐시·thinking 을 깨지 않는다 (사용자 결정 2026-10-17: 새 세션부터).

export class ClaudeSession {
  role: AgentSession 구현 (공통 뼈대는 base.ts, 2026-09-30) — id 는 EventLog.meta.id, seq 는 로그에서 이어받아 복원 뒤에도 단조
  export fn pendingApprovals() -> ApprovalRequest[] {
    role: attach 응답 pending — 대기 중 canUseTool 목록
  }
  export fn send(text, origin, attachments) {
    role: 턴 넣기 한 호출 — turn.start 이벤트(첨부는 이름·종류·크기만) 뒤 buildContent 로 큐 push. running 이면 다음 턴으로 줄 선다
  }
  export fn models() {
    role: SDK supportedModels + 지금 모델·effort (init 의 값 또는 setModel/setEffort 값, 첫 턴 전엔 getSettings 의 applied)
  }
  export fn setModel(model) {
    role: SDK setModel — 다음 턴부터. meta.model 에 남겨 복원 때 options.model 로 넘긴다
  }
  export fn limits() {
    role: 플랜 리밋 창(5시간·7일 %·리셋 시각) — SDK usage_EXPERIMENTAL(get_usage, 0.3.282 실험 메서드)의 rate_limits 만 골라 LimitWindow 로. 벤더 미기동·플랜 없음·오류면 null. 한 번에 1.5초쯤이라 폴링하지 않는다
  }
  export fn setMode(mode) {
    role: SDK setPermissionMode — 즉시. meta.permissionMode 에 남겨 복원 때 options.permissionMode 로 넘긴다. bypassPermissions 로 바꿀 수 있게 query 옵션 allowDangerouslySkipPermissions 를 켠다(그 자체는 우회가 아니다)
  }
  export fn commands() {
    role: SDK supportedCommands — 슬래시 명령 이름·설명·인자 힌트. 벤더 미기동이면 빈 배열
  }
  export fn context() {
    role: 컨텍스트 창 사용량(tokens·max·%) — SDK getContextUsage(summary). 벤더 미기동·오류면 null
  }
  export fn mcp() {
    role: MCP 서버 상태(이름·status·failed 면 error) — SDK mcpServerStatus. session.ready 의 mcp 는 기동 때 것이라 실패 사유가 없다. 벤더 미기동·오류면 빈 배열 (ticket slcode-mcp-failed-path)
  }
  export fn reconnectMcp(name) {
    role: SDK reconnectMcpServer(name) 뒤 mcp() — 실패해도 던지지 않고 목록의 error 로 돌려준다(목록에 사유가 없으면 던진 메시지를 싣는다). 목록에 없는 이름·벤더 미기동이면 오류
  }
  export fn setEffort(effort) {
    role: SDK applyFlagSettings({effortLevel}) — 세션 한정 설정층이라 설정 파일엔 안 쓴다. meta.effort 에 남겨 복원 때 options.effort 로 넘긴다. models() 가 지금 effort 와 모델별 supportedEffortLevels 를 같이 준다
  }
  export fn rewind(seq, conversation, files) -> String[]? {
    role: idle 일 때만. files 면 SDK rewindFiles(그 턴의 userUuid), conversation 이면 생성기를 닫고(restarting 플래그로 exit 이벤트를 막는다) 앞 턴의 uuid 를 resumeSessionAt 으로 run 재기동(유지 지점은 그 턴보다 앞의 마지막 turn.end 또는 session.imported 표지의 uuid — 표지는 가져온 턴들 뒤에 서므로 대상보다 앞의 것만 본다. 없으면 새 벤더 세션, 표지의 uuid 가 없으면 가져온 대화를 지킬 수 없어 오류. 되돌림을 반영한 로그는 eventLog.unrewound). turn.rewound 이벤트
  }
  export fn queued() -> Int {
    role: 보냈지만 아직 turn.end 가 오지 않은 턴 수 — idle 경계에서도 다음 턴이 줄 서 있을 수 있다
  }
  export fn reopen(env) {
    role: idle(또는 첫 프롬프트 전 starting)이고 줄 선 턴이 없을 때만(있으면 옛 프로세스와 함께 사라져 turn.end 가 오지 않는다 — 리뷰 2026-10-19) — 큐를 먼저 새로 바꾸고(내려가는 사이 온 프롬프트는 새 프로세스가 받는다) 생성기를 닫고(restarting) 기다린 뒤, 그사이 닫혔으면 그만두고 아니면 같은 벤더 세션으로 run 을 env 만 바꿔 재기동한다. inspect 토글이 쓴다 (ticket slcode-inspect-proxy). 세션 한정 승인 규칙(remember)은 rewind 처럼 잃는다
  }
  export fn interrupt() {
    role: 진행 턴 중단 — 그 턴의 승인 대기는 cancelled
  }
  export fn approve(requestId, decision, opts) -> Bool {
    role: 대기 승인 해소 — allow 는 updatedInput(AskUserQuestion 의 answers) + remember 면 세션 한정 규칙(sessionScoped), deny 는 message
  }
  export fn close(reason, quiet) {
    role: 대기 승인 cancel → interrupt → 생성기 반환 → session.exit·exited 이벤트 → 로그 닫기. quiet 면 두 이벤트를 남기지 않는다 — core 교체로 내릴 때(세션은 새 core 에서 이어진다). 벤더가 먼저 끝났으면(run 이 session.exit 를 냈으면) 아무것도 안 한다 — 종료 줄이 한 번만 남는다. close 뒤에 벤더가 오류로 끝나면(프로세스 그룹 시그널로 claude 도 같이 죽는다, exit 143) error 이벤트를 내지 않는다 (사용자 2026-10-11)
  }
  fn emit(ev, raw) {
    role: seq 발급·로그 append·구독자 호출. session.state 는 상태도 갱신
  }
  fn onMessage(m) {
    role: SDK 메시지 → 이벤트 정규화 (system init/session_state_changed/compact_boundary/hook_*, stream_event 델타, assistant tool_use, user tool_result, result). session_id 가 바뀌면 meta 갱신
  }
}
export fn summarize(content) -> Text {
  role: tool_result content → 400자 요약 — 실시간 tool.end 와 가져온 기록(history)이 같이 쓴다
}
export fn buildContent(text, attachments) {
  role: 텍스트 + 첨부 → Messages API content — 이미지(png/jpeg/gif/webp)·PDF 는 image/document 블록, 그 밖은 UTF-8 로 풀어 <file name> 인라인. 첨부 없으면 문자열 그대로
}
fn sessionScoped(suggestions, toolName) -> PermissionUpdate[] {
  role: 벤더 제안 규칙을 destination session 으로 (t3code acceptForSession — 그대로 돌려주면 .claude/settings.local.json 에 영구 규칙이 써진다). 제안이 없으면 도구 전체 허용 규칙 하나
}
type SessionOptions
