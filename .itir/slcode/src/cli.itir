import { connectSession, diskBuild } from './client'
import { sendMail, sessionMeta } from './mail'
import { EventLog } from './eventLog'
import { corePaths, readOrCreateToken } from './paths'
import { pluginMethod, PLUGIN_METHODS, serveSession } from './serve'
import { runEntry } from './entry'
import { reachable, closedSessions, closedTime, sockAlive } from './live'
import { findVendorSession, forkClaude, vendorResumeCommand } from './vendor'
import { pullHistory } from './history'
import { forkSession } from './fork'
import { CLAUDE_EFFORTS, sessionEnv } from './base'
import { pluginCommand } from '../slcode-plugin/src/cli'
import { addProfile, getProfile, listProfiles, removeProfile, setProfile, Profile } from './profiles'
import { summarize } from './activity'

role: --stdio 의 stderr 는 카드에 닿지 않아 hello 전에 오류로 끝나면 마지막 오류를 stdout 프레임 {fatal} 로도 낸다. 단독 실행 진입점 (bin slcode) — 동사 하나를 받아 한 번 부르고 끝난다 (ticket slcode-verbs, 사용자 확정 2026-10-02). --help 는 도움말(묶음별, 세션 안 전용 동사는 * 표식). 동사 없는 호출(인자 없음 또는 첫 토큰이 옵션)은 `new .` — 옵션만 받고 위치 인자는 거부한다(폴더·세션 id 를 동사로 읽지 않게, ticket slcode-bare-new 사용자 2026-10-07, slcode-verbs 의 "bare 는 도움말" 을 뒤집음). new·resume·continue 는 같은 규칙 (ticket slcode-resume-like-new, 사용자 결정 2026-10-11): superlite 터미널 안(SUPERLITE_SOCK)이고 `--web`·`--stdio` 가 없으면 웹을 열지 않고 PATH 의 `superlite` 심으로 플러그인 동사를 불러 요청자 터미널의 deck 에 카드를 맡기고 그 출력을 찍고 끝난다 — 새 세션은 `slcode.new [--focus] --cwd <abs> [--vendor --title --mode --model --effort --profile --env <NAME=VALUE 줄들> --prompt <첫 프롬프트>]`(출력은 세션 id. `--focus` 는 사람이 터미널에서 친 호출일 때만 — SLCODE_SESSION_ID·CLAUDECODE·CODEX_THREAD_ID 가 없고 stdin·stdout 이 TTY. 그때만 사용자가 그 터미널을 보고 있으면 새 카드로 넘어가고, 아니면 동사 기본값대로 deck 끝에 조용히 붙는다 — ticket slcode-new-card-no-focus 사용자 2026-10-25, 2026-10-07 의 늘 포커스를 뒤집음. `--focus` 를 모르는 옛 플러그인(unknown option --focus)이면 빼고 다시 부른다), 저장 세션은 `slcode.resume --id <id>`(살아 있으면 그 카드 활성화, 없으면 resume 카드). 심 없음·연결 불가(exit 3)·unknown verb(플러그인 미설치·비활성·옛 플러그인)면 웹 서빙으로 돌아오고, 그 밖의 동사 실패는 그 사유로 exit 1. superlite 밖이거나 `--web` 이면 꺼진 세션은 이 프로세스가 세션이 되어 웹 서빙, 살아 있는 세션은 server.info 의 웹 주소를 stdout 에 찍고 끝난다(웹이 없는 세션 — --no-web·카드 서비스 — 이면 "live but has no web address" 한 줄과 exit 1). `--stdio` 는 카드 서비스 자신이라 카드 경로를 타지 않는다(순환 방지). `--host`·`--port` 는 웹 서빙일 때만: `--no-web` 과 함께(`--web --no-web` 도) 주면 usage 오류, 카드로 갈 자리에서 `--web` 없이 주면 "warning: --port is ambiguous inside superlite; add --web …, or drop it to open a card" 한 줄과 exit 2 로 아무것도 열지 않는다(카드인지 웹인지 넘겨짚지 않는다). 카드 경로에서 쓰지 않는 --no-web·--raw·--no-inspect·--dir(resume 은 --title·--mode 도)은 "warning: ignoring …" 한 줄. 세션 수명: `new [folder] [--port --host --no-web --raw --no-inspect --mode --title --vendor --model --effort] [-- <첫 프롬프트>]`(--model: 새 세션의 모델 — meta.model 로 시작, ticket slcode-plugin-relations 2026-10-22. `--model <공급자>:<모델>` 이면 공급자로 벤더를 고른다 — anthropic → claude, openai → codex, 앞머리를 뗀 나머지가 모델(정식 형식, 사용자 2026-10-24: slcode 에 모델 목록이 없어 모델 이름만으로는 벤더를 모른다). 다른 앞머리·앞머리 없음은 이름 전체가 모델(Bedrock id 의 `:0` 등), --vendor 와 맞지 않거나 모델이 비면 usage 오류. --effort: 새 세션의 effort — meta.effort 로 시작, Claude 면 low|medium|high|xhigh|max 밖의 이름은 아무것도 열지 않고 usage 오류(exit 2), Codex 는 effort 이름이 모델마다 열려 있어 이름을 보지 않는다 — 모델에 없는 값은 벤더가 뜬 뒤 core 가 알리고 벤더 기본으로. `--` 뒤의 단어들은 공백으로 이어 첫 프롬프트로 — core 가 세션을 만들자마자 session.send 와 같은 길로 넣어 벤더 준비 전이라도 첫 턴으로 돈다, 위치 인자 폴더는 `--` 앞만. 이 셋(--model·--effort·첫 프롬프트)은 새 세션에만 — resume·import·꺼진 세션을 찾은 continue·id 없는 resume 에 주면 아무것도 열지 않고 usage 오류(exit 2), 꺼진 세션이 없어 새 세션을 여는 continue 는 받는다. ticket slcode-new-effort-prompt 사용자 결정 2026-10-23. `--` 를 나누는 것은 세션 수명 동사(new·continue·resume·import·동사 없는 호출)만이고 그 밖의 동사는 `--` 뒤도 지금처럼 위치 인자)(inspect: 새 세션은 들어온 입구 — --stdio 면 superlite, 아니면 web — 의 설정 Settings.inspect 를 따르고, Claude 는 inspect-blocked.json 이 이 SDK 를 막았으면 경고 한 줄과 함께 끈다(Codex 는 막힌 기록과 무관, ticket slcode-inspect-codex), --no-inspect 는 끈 채로 시작하고 resume 이면 켜져 있던 것을 끈다, ticket slcode-inspect-default-on; 이 프로세스가 serve.ts 로 core 를 detached 로 띄우고 그 소유자 serve + 웹 서버가 되어 URL 또는 소켓 경로를 찍는다, 0.0.0.0 은 접속 가능한 IPv4 로; Ctrl-C·SIGTERM·SIGHUP 은 세션을 닫고 resume 안내 — ticket slcode-core-serve-split), `resume <s>`(저장 세션을 다시 띄움, 살아 있으면 위 규칙대로 카드 활성화 또는 웹 주소), `resume`(id 없음: 현재 폴더의 꺼진 세션을 꺼진 순서(closedTime, 최근 먼저)로 — superlite 안이면 `slcode.resume --cwd <abs>` 로 카드 안에서 고르고, 밖이면 `id  YYYY-MM-DD HH:MM  제목` 줄을 찍고 끝난다; 없으면 exit 1), `continue [folder]`(그 폴더에서 가장 최근에 꺼진 세션 — 살아 있는 세션은 뺀다, live.closedSessions — 을 resume 과 같은 길로, 없으면 new 와 같은 길로 새 세션), `import <벤더 세션 id> [--vendor claude|codex] [--title --mode]`(ticket vendor-import 2026-10-07 → slcode-import-history 사용자 결정 2026-10-15: Claude Code·Codex 에서 하던 세션을 vendor.ts 로 찾아 늘 복제본으로 slcode 세션을 만든다 — 원본은 벤더에 그대로 두고 meta.forkFrom 에 적는다. Claude 는 이 자리에서 forkClaude 로 새 id 를 받아 vendorSessionId 로, Codex 는 meta.forkFrom 만 두고 세션 프로세스 첫 기동이 thread/fork(turn id 는 그대로 남는다, 2026-10-15 실측). 이전 대화는 history.pullHistory 가 events.jsonl 에 옮겨 쓰고 session.imported 표지를 그 뒤에 둔 다음 resume 과 같은 길로 띄운다. 폴더는 벤더 기록에서. 같은 원본을 다시 import 하면 또 새 복제본(이미 가져온 slcode 세션을 한 줄 안내). 받은 id 가 slcode 세션이 이어 쓰는 벤더 세션(vendorSessionId — export 뒤 벤더에서 이어 간 복제본, 옛 import 의 원본)이면 복제하지 않는다: 꺼져 있으면 pullHistory 로 늘어난 턴을 이어 붙이고, 살아 있으면 붙이지 않는다는 한 줄을 찍고, 그 세션을 resume. 원본을 같이 쓰던 옛 방식과 --fork 는 없앴다), `export <s>`(그 세션을 벤더 하네스에서 이어 갈 명령 한 줄을 stdout 에 — 턴이 없어 vendorSessionId 가 없으면 exit 1, 살아 있으면 stderr 경고만; 벤더 세션이 slcode 와 같은 저장소라 따로 옮길 것이 없다), `list [--all]`(폴더 순회 + 세션 소켓에 붙어 보아 live, pid 는 live 일 때 meta.pid, updatedAt 순; 기본 live 만 — 에이전트가 상대를 고르는 목록, --all 은 꺼진 세션까지; 행에 vendor·closedAt·me, 살아 있는 행에는 activity.summarize 의 state·stateSince·seen — 활동 기록이 없으면 null·null·true, superlite 사이드바용 ticket slcode-sidebar-orca), `rename`(꺼져 있으면 meta 만)·`close [--force]`·`delete`. `close --force`(사이드바 강제 종료, 사용자 결정 2026-10-11): session.close 를 보내고 3초 안에 소켓이 닫히지 않으면(멈춘 세션) meta.pid(core 가 남긴 것)를 SIGKILL 하고 meta.closedAt 을 대신 남긴다; 출력 {ok, killed}, 살아 있지 않으면 exit 1. 대화: `prompt <s> <text>`(session.send)·`interrupt`. 조회(평문 기본, --json 이면 같은 내용): `status`(상태·모델·권한 모드·턴 수·비용 합·컨텍스트·대기 수)·`pending`(승인|질문, 요청 id·도구 또는 질문·입력 요약·선택지)·`last [--turn N]`(turn.start 경계로 자른 마지막 또는 N 턴 전의 턴)·`log [--since N] [--tail N]`(렌더는 last 와 같고 --json 은 원문 한 줄씩) — 살아 있으면 session.attach 의 history·pending, 꺼져 있으면 events.jsonl 에서 같은 꼴로. 응답 `respond <s> <req> allow|deny [--remember] | --answer <text> | --json '<updatedInput>'`: 요청 id 필수, 열려 있지 않으면 오류 + 지금 대기 중인 id 목록(미리 보관 없음); --answer 는 질문 하나일 때 선택지 번호·라벨·자유 텍스트를 updatedInput.answers {질문문: 답} 으로. 메시지(ticket slcode-p2p-messaging, 사용자 결정 2026-10-19 — 우체국 없음): `mail <to> <text> [--from X] [--re <id>]`(mail.sendMail — <to> 는 켜진 세션의 id 또는 제목, 못 찾으면 꺼져 있든 없든 no session 으로 exit 1; 출력 {id, to}. from 은 --from, 없으면 SLCODE_SESSION_ID, 둘 다 없으면 unknown. via 는 자동: 세션 안에서 from 이 자기 세션과 다르면 그 세션 id, 세션 밖이면 outside — 옵션으로 열지 않는다. --re 는 그 메시지의 답장 kind=reply. 기본은 fast — 받는 세션이 턴 중이어도 바로 넣는다, --lazy 면 받는 세션이 idle 이 된 뒤 (Mail.lazy, ticket slcode-team-agent)), 세션 안 전용 `check`·`ask <to> <text> [--timeout S]`·`reply <메시지 id> <text>`(자기 세션 소켓의 session.check/ask/reply, 실패해도 소켓을 닫는다). post·inbox 동사는 없다 (꺼진 세션에 보관하지 않는다). <s>·<to> 는 모든 동사에서 세션 id 또는 유일한 제목(저장 세션 meta 전체에서, 여럿이면 후보 나열 후 실패, 모르는 값은 그대로; 메시지의 받는 이는 mail.findLive 가 켜진 세션에서 찾는다). 옛 동사(send·approve·shutdown·post 단독·폴더 위치 인자·--resume/--continue 옵션·attach — 2026-10-11 삭제, 사람은 웹·카드, 에이전트·스크립트는 prompt·respond·log·last·pending)는 폐기, 폴백 별칭 없음. --dir 은 SLCODE_DIR 대체. 인자는 node:util parseArgs. `--mode` 는 생략하면 새 세션(import 포함)이 auto 로 시작하고(사용자 2026-10-24), PERMISSION_MODES(default·auto·bypassPermissions) 밖의 값이면 동사와 무관하게 아무것도 열지 않고 usage 오류(exit 2) — 옛 acceptEdits·plan 도 (ticket slcode-permission-modes-three, 사용자 결정 2026-10-23). 프로토콜 메서드는 기존 것만 쓴다(새 메서드 없음). `--stdio`(new·resume·continue, 2026-10-04): serve 에 stdio 통로를 켜고 stdout 첫 줄에 hello JSON {url, id, sock} 을 찍는다(그 뒤 stdout 은 프레임만, 로그는 stderr) — superlite 에이전트 카드가 백그라운드 서비스로 띄울 때의 모양. `resume --stdio` 가 살아 있는 세션을 만나면 attachStdio: 소켓에 server.info 를 한 번 물어 hello 를 만들고(옛 빌드면 host·port·토큰으로) serve 의 attach(소유자 아님 — core 를 띄우지 않는다)로 stdio·서비스 웹을 그 소켓에 중계한다 — 카드가 떠 있는 세션에 붙는 길. stdin 이 닫히면 끝나고 세션은 그대로. `--takeover`(resume --stdio, ticket slcode-core-serve-split 2단계): 그 attach 가 소유권을 빼앗는다 — 카드 핸드오프의 새 카드. 소유자가 되었으므로 SIGINT·SIGTERM·SIGHUP 은 new --stdio 처럼 세션을 닫는다(close('signal') → session.close; 없으면 superlite 가 카드를 멈출 때 core 가 owner gone 유예 뒤에야 닫혔다, ticket slcode-takeover-signal-close). --takeover 없는 attach 는 시그널 처리 없이 끝나고 세션은 그대로. 웹 모드(--stdio·--no-web 없이 new·resume·continue)는 이 프로세스가 entry.runEntry 의 진입 프로세스가 되어 serve 를 자식으로 띄우고 교체한다; --stdio·--no-web 은 지금처럼 이 프로세스가 곧 serve. `--version [--json]`: 동사보다 먼저 — 디스크의 이 설치(diskBuild)를 `slcode <version>` 또는 {version, build} 로 찍고 끝난다 (플러그인의 [업데이트] 가 받아 둔 slcode 에 묻는다). 에이전트 플러그인(ticket slcode-agent-plugin, 2026-10-27): `plugin add <folder>`(agentPlugins.addPlugin — 출력 {name, version, changed, grade, lost, build}, manifest 가 없거나 깨지면 exit 1)·`plugin remove <name>`({name, removed}, 없어도 성공)·`plugin set <name> <part>=on|off <option>=<value> ...`({name, values, build}, 틀리면 아무것도 바꾸지 않고 exit 1)·`plugin list [--json]`(평문은 플러그인마다 이름·판·등급, part, 옵션, 하네스별 빠지는 것, claude·codex 마지막 빌드의 식별자·지시문 수·덮어씀·뺀 것·빠진 것). export 는 slcode-agent-plugin-export. 시작 프로필(ticket slcode-session-profile, 사용자 결정 2026-10-28): new·continue(새 세션일 때) --profile <이름> — 없는 프로필이면 아무것도 열기 전에 거절(checkNew), resume·import·꺼진 세션을 찾은 continue 에 주면 --model 처럼 거절(onlyNew), 카드로 열 때는 slcode.new 에 --profile 로 넘긴다. 세션 env(ticket slcode-new-session-env, 사용자 결정 2026-11-01): new·continue(새 세션일 때) --env NAME=VALUE(여러 번, base.sessionEnv) — 이름 오류는 아무것도 열기 전에 거절(checkNew), resume·import·꺼진 세션을 찾은 continue 에 주면 거절(onlyNew), 카드로 열 때는 slcode.new 에 --env 하나로 줄바꿈으로 합쳐 넘긴다(superlite 동사 인자는 option 반복을 마지막 값만 남긴다). 동사 없는 slcode 에 주면 다른 세션 옵션처럼 거절. 세션 인자(ticket slcode-agent-plugin-part-when, 사용자 결정 2026-11-02): --param NAME=VALUE·짧게 -P(여러 번, base.sessionParams) — --env 와 같은 규칙으로 거절·onlyNew, 카드로 열 때는 slcode.new 에 --param 하나로 줄바꿈으로 합쳐 넘긴다. `profile add <이름> [--from P]`·`remove`·`set <이름> <키>=<값>...`·`list [--json]`(profiles.ts) — 평문은 프로필마다 plugins·claude 두 줄. 시작 화면(ticket slcode-session-profile, 사용자 2026-10-30 — 2026-10-07 의 "동사 없는 slcode = new ." 를 바꿈): 동사 없는 slcode 는 지금 폴더의 시작 화면 — superlite 안이면 slcode.start 동사로 카드(옛 플러그인이면 웹), 밖이면 startWeb: runEntry 에 choose 를 넘겨 루프백 웹으로(주소는 처음 한 번만 찍는다; 루프백 밖이면 오류), 고른 세션이 첫 메시지 전에 시작 화면으로 돌아오면(EntryHandle.back) 같은 포트에 다시 연다. 세션 옵션(--vendor·--title·--profile·첫 프롬프트 등)은 받지 않는다 — 새 세션은 new <folder>. new 는 폴더를 꼭 받고(없으면 오류) 늘 바로 대화 화면이다; --from-start 는 카드가 시작 화면에서 연 새 세션(meta.fromStart). start-page [folder] [--json] 은 superlite 카드의 시작 화면 html(startPage.startPageHtml inline), --json 이면 그 목록(startList). start-call <plugins.list|check|set|export> [<json>] 은 카드 시작 화면의 에이전트 플러그인 관리 요청(serve.pluginMethod 결과 JSON, ticket slcode-agent-plugin-export-action — 관리 화면의 입구는 시작 화면뿐이라 카드도 이 길로). discard <s> 는 카드의 '시작 화면으로' — 시작 화면에서 연 첫 메시지 전 세션만 닫고 지운다(live.discardSession).
fn teamNew(rest) {
  role: 세션 안(SLCODE_SESSION_ID) 전용 `slcode team new [--cwd <폴더> | --worktree [이름]] [--subagent|-s | --teammate|-t | --detached|-d] [--wait] [-n/--name N] [-m/--model M] [-e/--effort E] [--mode M] [-o/--options '<JSON>'] [--profile·--env·-P] [-- <지시> | stdin]` (ticket slcode-team-agent, 사용자 결정 2026-11-07~08). 사람이 쓰는 명령이 아니라 세션 안의 모델이 Bash 로 친다 — 세션 밖이면 오류. 그 세션 core 에 session.spawnChild 를 청하고 팀원 id 를 출력하고 바로 끝난다. 작업 폴더는 --cwd(ticket slcode-team-worktree, 사용자 2026-11-11 — 위치 인자를 받던 11-09 결정을 바꿨다, 위치 인자를 주면 usage 오류), 생략하면 지금 폴더. --worktree [이름] 이면 지금 폴더가 속한 checkout 의 HEAD 에서 worktree.createWorktree 로 worktree 를 만들고(이름은 브랜치 이름 그대로, 빼면 --name 에서 짓는다) 팀원을 그 맨 위에서 띄우며 spawnChild 의 worktree 로 넘긴다 — --cwd 와 함께면 usage 오류, 띄우기가 실패하면 만든 worktree 를 지운다. 값 없는 --worktree(뒤가 없거나 - 로 시작)는 parseArgs 전에 --worktree= 로 바꿔 읽는다(parseArgs 에 값이 선택인 옵션이 없다). 관계 프리셋의 cleanWithLeader 는 endWithLeader 를 끈 -o 에서 따로 주지 않았으면 같이 끈다(--subagent 에 -o '{"endWithLeader":false}' 만 줘도 오류가 나지 않게). stderr 의 시작 줄은 worktree 면 'on branch <브랜치>' 를 덧붙인다(MCP 도구가 읽는다). 관계 프리셋(--subagent·--teammate·--detached)은 여섯 옵션의 기본값을 채우고 생략하면 teammate, -o 의 JSON 이 그 위에 얹힌다(모르는 키·불리언이 아닌 값은 거절). --name 은 제목. --model 은 `<회사>:<모델>`(anthropic·openai) 이면 벤더도 고르고, 앞머리가 없으면 모델 이름으로 벤더를 고른다(claude-*·opus·sonnet·haiku·fable → claude, gpt-*·o<숫자>·codex → codex, 그 밖은 리더의 벤더). 주지 않은 값은 리더를 따른다(core). 지시는 `--` 뒤 단어들, 없으면 stdin 이 파이프나 파일일 때만 읽는다(heredoc — Claude Code Bash 도구의 stdin 은 닫히지 않는 소켓이라 읽으면 멈춘다). 파이프가 열린 채 0.5초 안에 아무것도 오지 않으면 지시 없이 띄운다(닫히지 않는 파이프를 주는 도구에서 멈추지 않게). superlite 안이면 superlite slcode.resume --id 로 요청자 deck 끝에 팀원 카드를 조용히 연다(실패해도 그만) --wait 면(출력 수신 팀원만, 지시 필수) 지시 없이 띄운 뒤 id 를 stderr 로 내고 childCall session.send {wait} 로 첫 지시를 보내 그 답을 stdout 에 낸다 (사용자 2026-11-08, MCP 도구 Subagent 가 이 길을 쓴다). --agent <이름> 은 리더 세션 폴더에서 찾은 에이전트 정의(teamAgents.findAgent)의 model·effort·mode·profile·relation 을 주지 않은 옵션의 기본값으로 쓰고(모델 앞머리 해석보다 먼저), 그 이름과 본문 지시문을 spawnChild 의 agent 로 넘긴다. 없는 이름이면 있는 정의 목록과 함께 usage 오류, 정의의 relation·mode 가 틀려도 usage 오류 (ticket slcode-team-agent, 사용자 2026-11-09)
}
fn teamCleanWorktree(rest) {
  role: `slcode team clean-worktree <팀원> [--key K]` · `slcode team clean-worktree --self [--key K]` (ticket slcode-team-worktree·slcode-team-worktree-self, 사용자 2026-11-11) — `team new --worktree` 로 띄운 팀원의 worktree 와 브랜치를 지운다. <팀원> 은 세션 밖에서도 되고(리더가 죽은 뒤 사람이 정리) 리더는 어느 관계의 팀원이든 지울 수 있다. --self 는 이 세션(SLCODE_SESSION_ID)의 것을 자기 세션을 닫지 않고 지운다 — 세션 밖이면 오류, <팀원> 에 자기 id 를 주면 --self 를 쓰라는 usage 오류. 팀원은 id 나 제목, meta.worktree 가 없으면(slcode 가 만들지 않은 worktree) 오류, 이미 지웠으면 그렇다고 알리고 끝난다. worktreeLoss 가 있고 --key 가 그 확인 키와 다르면 사유와 다시 칠 명령(--key <키>)으로 거절한다 — 닫기 전에 먼저 보므로 거절할 때는 팀원을 닫지 않는다. --force 는 받지 않는다(usage 오류, wtree 처럼 키만이 버리는 길). 그다음 켜진 팀원은 닫고(--self 가 아닐 때, 이 세션의 link 팀원이면 viaParent, 아니면 session.close — 소켓이 닫힐 때까지 기다린다) 잃을 작업을 다시 본다 — 닫는 사이 바뀌어 키가 달라졌으면 거절. 확인한 잃을 작업은 버리고 지운다. 지우면 meta.worktree.removedAt 을 남긴다 — 세션 기록은 지우지 않고, 리더가 다시 시키면 Children.reopen 이 알기 쉬운 오류로 거절한다
}
fn viaParent(s, method, params, wait) {
  role: <s> 가 이 세션(SLCODE_SESSION_ID)의 link 팀원이면 prompt·interrupt·respond·close 를 리더 core 의 session.childCall 로 — 입력 제어 중인 팀원은 리더 소유 연결의 지시만 받는다. 팀원이 아니면 null. mail 의 <to> 가 leader·parent 면 SLCODE_PARENT_ID(link 팀원 안), list 행에 parent, worktree 팀원이면 worktree(ticket slcode-team-worktree). `slcode new` 는 세션 안에서도 언제나 독립 세션이다(사용자 2026-11-07) wait 면 리더 core 가 답을 응답으로 돌려준다 — `slcode prompt <팀원> --wait` 이 그 답을 출력한다(이 세션의 팀원이 아니면 오류). 답하고 닫힌 팀원은 리더 core 가 다시 띄운다
}
