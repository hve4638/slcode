import { FILES } from './protocol'

role: custom provider (ticket slcode-custom-provider, 사용자 결정 2026-11-25) — Anthropic·OpenAI 공식 계정이 아닌 프로바이더(OpenRouter 같은 제3자, Ollama·LM Studio 같은 로컬 모델)로 세션을 돌린다. 프로바이더 하나는 엔진(vendor: claude 면 Claude Code 가 Anthropic Messages 주소로, codex 면 Codex 가 OpenAI Responses 주소로) + 주소·키·모델 목록 + 세부(키 전달 방식·추가 헤더·등급별 모델·기능 표시·추가 env)다. 모델마다 토큰 한도(limits — 모델 이름 → {context, output})를 둘 수 있다: 벤더는 모르는 모델의 크기를 추정하므로 ctx % 와 자동 압축이 실제 크기를 따르게 하려면 적어 준다(ticket slcode-provider-token-limits). limits 에는 models 에 있는 모델만 남는다. 저장은 상태 폴더의 providers.json 하나(브라우저·superlite 카드·CLI 가 같이 쓴다), 키는 그 파일에 평문이고 파일 권한은 0600 (사용자 결정 — OS 키 저장소·env 이름 참조는 두지 않는다). 키는 프로바이더에 직접 넣거나, 같은 파일의 키 관리(keys)에 둔 키 하나를 keyRef 로 가리킨다 — 여러 프로바이더가 한 키를 같이 쓰고 값을 한 곳에서 바꾼다 (사용자 2026-11-26). 읽을 때 keyRef 를 그 키 값으로 채워 Provider.key 로 두므로 키를 쓰는 곳(벤더 env·인자·목록 받기)은 가리킴을 모른다. 디스크의 프로바이더에는 keyRef 만 적는다. 세션은 meta.provider 에 id 만 적는다 — 띄울 때마다 지금 값을 읽고, 지워졌거나 엔진이 바뀌었으면 공식 계정으로 넘어가지 않게 열지 않는다(core). 벤더 env·인자에서 무엇을 넣고 빼는지는 이 모듈 한 곳이 고른다: custom 세션은 셸·--env·플러그인 manifest env·~/.claude/settings.json 어디서 온 연결 값(CONNECTION_ENV — ANTHROPIC_* 연결, 1st party 내부 플래그 _CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL, ENABLE_TOOL_SEARCH)도 쓰지 않고 프로바이더 값만 쓴다. 근거와 표는 ws docs/report/slcode-custom-provider.md. TEMPLATES: 잘 알려진 프로바이더의 미리 채운 값 — 엔진별 주소(Codex 주소가 없는 곳은 Codex 를 고를 수 없다), 기본 키(로컬 서버), 추가 헤더(OpenRouter 의 HTTP-Referer·X-OpenRouter-Title), 기본 모델·등급 대응, 기능 표시, 모델 목록 API 의 꼴, 알려진 제한 한 줄. 값은 공식 문서로 확인한 것 (2026-11-25). 'custom'(직접 만들기)은 자리 주소(localhost:8080)만 든 템플릿 — 새 프로바이더 창은 템플릿 카드만 보이고 누르면 그 값으로 바로 만든다, 이름·벤더·주소·키는 일반 탭에서 고친다 (사용자 2026-11-26). CONNECTION_ENV: custom 세션의 Claude 벤더 env 에서 지우는 이름 — 어디서 왔든(셸·meta.env·플러그인 env). 프로바이더 값(claudeConnection)이 다시 채운다. PROVIDER_KEY_ENV: Codex 벤더 프로세스 env 에 키를 넣는 이름 — model_providers.<id>.env_key 가 가리킨다. SLCODE_* 라 --env 로 덮지 못한다.

export val TEMPLATES
export val CONNECTION_ENV
export val PROVIDER_KEY_ENV
export type ProviderVendor
export type Provider
export type ProviderFeatures
export type ProviderTemplate
export type ProviderModel
export type ProviderKey
export type ModelLimits
export fn readProviders(dir) -> Provider[] {
  role: providers.json 의 프로바이더들. 없거나 읽을 수 없으면 빈 목록, 꼴이 틀린 항목은 버린다. keyRef 는 키 관리의 값으로 채운다(없는 키를 가리키면 키 없음)
}
export fn readKeys(dir) -> ProviderKey[] {
  role: 키 관리의 키들 (id·이름·값)
}
export fn getProvider(dir, id) -> Provider? {
  role: id 로 하나
}
export fn saveProvider(dir, input) -> Provider {
  role: 추가·고치기 (id 가 있으면 고친다, 없으면 이름에서 만든 새 id). key 를 주지 않으면 지금 키를 남긴다 — 화면은 키를 받지 않으므로. key 를 주면 직접 넣은 키(가리킴을 푼다), keyRef 를 주면 키 관리의 그 키(없는 키면 거절). 이름·엔진·주소를 검사하고(엔진이 템플릿에 없으면 거절), 임시 파일 + rename, 권한 0600
}
export fn saveKey(dir, input) -> ProviderKey {
  role: 키 관리 — 추가·고치기. id 가 있으면 고친다(value 를 주지 않으면 지금 값), 없으면 이름에서 만든 새 id. 이름·값이 비면 거절. 가리키는 프로바이더는 다음에 읽을 때 새 값을 쓴다
}
export fn removeKey(dir, id) -> Bool {
  role: 키 관리 — 지운다. 쓰는 프로바이더가 있으면 그 이름을 들어 거절한다 — 프로바이더가 말없이 키 없이 돌지 않게
}
export fn publicKey(k, providers) {
  role: 화면으로 내보낼 키 — 값은 빼고 끝 4자와 쓰는 프로바이더(id·이름)
}
export fn providerOpenError(dir, meta) -> Text? {
  role: custom 세션을 열 수 없는 사유 — 프로바이더를 지웠거나 엔진이 바뀌었다. 공식 계정으로 넘어가 다른 곳에 대화를 보내지 않게 열지 않는다. core 가 띄울 때와 시작 화면이 고를 때 같이 쓴다 (시작 화면은 고르기 전에 걸러야 프로세스가 끝나지 않는다)
}
export fn removeProvider(dir, id) -> Bool {
  role: 지운다. 그 프로바이더로 만든 세션은 다음에 열 때 사유를 알리고 열리지 않는다
}
export fn publicProvider(p) {
  role: 화면·CLI 로 내보낼 꼴 — key 는 빼고 hasKey 와 끝 4자만
}
export fn claudeConnection(p, model, baseUrl) -> Env {
  role: Claude 벤더에 넣을 연결 env — 주소(inspect 면 proxy 주소), 키(Bearer 면 ANTHROPIC_AUTH_TOKEN 과 빈 ANTHROPIC_API_KEY, x-api-key 면 반대. 키가 비어도 빈 값으로 두지 않는다 — Claude Code 가 사용자 claude.ai 로그인으로 넘어가 그 토큰을 제3자 주소에 보내지 않게), 모델·등급별 모델(비우면 고른 모델), 추가 헤더(ANTHROPIC_CUSTOM_HEADERS), 고른 모델의 토큰 한도(modelLimits — context 는 CLAUDE_CODE_MAX_CONTEXT_TOKENS, output 은 CLAUDE_CODE_MAX_OUTPUT_TOKENS. 프로바이더 추가 env 의 같은 이름보다 앞선다), 바깥 연결 끄기(CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC), claude.ai 커넥터 끄기, tool search·beta(기능 표시 betas 가 꺼져 있으면 CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS·ENABLE_TOOL_SEARCH=false), 1st party 내부 플래그는 빈 값. 프로바이더 추가 env 는 그 아래. 같은 값이 SDK 플래그 settings.env 에도 들어간다 — ~/.claude/settings.json 의 env 가 프로세스 env 를 덮기 때문 (2026-11-25 스파이크)
}
export fn withoutConnection(env) -> Env {
  role: CONNECTION_ENV 를 뺀 env
}
export fn claudeThinking(p) {
  role: SDK thinking 옵션 — 기능 표시가 켜져 있으면 고정 예산(enabled), 아니면 disabled. adaptive 는 1st party 밖에서 400 이 난다 (Claude Code 게이트웨이 문서)
}
export fn codexProviderArgs(p, model, baseUrl) -> Text[] {
  role: Codex app-server 의 -c 인자 — model_provider="slcode-<id>", model_providers.slcode-<id>.{name, base_url(inspect 면 proxy 주소), env_key(키가 있을 때만 — 없는 env 를 가리키면 Codex 가 거절한다), wire_api="responses", http_headers}, 고른 모델의 context 한도가 있으면 model_context_window (Codex 는 출력 한도 설정이 없어 output 은 쓰지 않는다)
}
export fn codexProviderEnv(p) -> Env {
  role: Codex 벤더 프로세스 env 에 얹을 것 — 프로바이더 추가 env 와 PROVIDER_KEY_ENV
}
export fn modelLimits(p, model) -> ModelLimits {
  role: 모델의 토큰 한도 (ticket slcode-provider-token-limits, 사용자 결정 2026-11-27 — 프로바이더가 아니라 모델마다). model 이 비면 첫 모델. 적지 않은 값은 빠진다 — 벤더 기본(Claude Code 는 모르는 모델을 200000·출력 32000, Codex 는 258400 으로 본다)
}
export fn fetchModels(p) -> ProviderModel[] {
  role: 프로바이더의 모델 목록을 받는다 (5초). OpenRouter 는 /api/v1/models, Ollama 는 /api/tags, 그 밖은 Claude 엔진이면 <주소>/v1/models(Anthropic 꼴 헤더), Codex 엔진이면 <주소>/models. 응답은 data[].id(+name·display_name·크기 — context_length, llama.cpp 는 meta.n_ctx: 서버가 띄운 크기이고 n_ctx_train 은 학습 길이라 쓰지 않는다) 나 models[].name. 실패하면 사유로 던진다 — 화면은 손으로 넣는 칸을 그대로 둔다
}
fn readStore(dir)
fn normalize(v, keys) -> Provider?
fn write(dir, list, keys)
fn slug(name, fallback) -> Text
