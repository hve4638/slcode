import { EventLog } from './eventLog'
import { connectSession } from './client'
import { sockAlive } from './live'
import { CoreError, ERR, Mail } from './protocol'

role: 세션 사이 메시지 (ticket slcode-p2p-messaging, 사용자 결정 2026-10-19 — 우체국 없이 P2P). 받는 이는 켜진 세션 중에서 id 또는 제목으로 찾아 그 소켓의 session.deliver 로 넘긴다. 못 찾으면 꺼져 있든 없든 no_session — 꺼진 세션에는 보내지 않고 보관함도 없다 (보관하면 같은 제목의 옛 세션이 계속 지목되어 받는 이가 모호해진다). 메시지 id·ts 는 보내는 쪽이 정한다(받는 core 가 같은 id 를 한 번만 받는다). via 는 실제로 넘긴 쪽 — 보내는 CLI 가 자동으로 채운다(세션 안에서 다른 from 이면 그 세션 id, 세션 밖이면 outside), 옵션으로 열지 않는다. env 조작·같은 사용자의 소켓 직접 호출은 막지 않는다. 턴 본문 꼴은 slcode 독자 머리표 `<slcode-message id from name kind at [via] [re]>\n본문\n</slcode-message>` (여러 통은 빈 줄로 이어 한 턴) — Claude Code 의 peer 봉투(<cross-session-message>)는 권한 부류가 다르면 보류되고 SDK 에 승인 수단이 없어 버려지므로 쓰지 않는다(실측 2026-10-19). 머리표의 뜻은 prompt.ts 의 고정 지시가 알린다. 속성값의 & " < > 와 줄바꿈은 이스케이프, 본문의 닫는 태그는 <\/slcode-message 로. web/app.js 의 파서는 MAIL_RE 의 사본(브라우저라 import 못 한다)

export fn formatMail(m, fromName) -> String {
  role: 머리표 + 본문(문자열 아니면 JSON). name 은 from 세션의 제목(없으면 뺀다)
}
export fn parseMails(text) -> MailHead[] {
  role: 한 턴 본문에서 머리표의 속성 — 재기동 뒤 reply 대상 복원
}
export fn sessionMeta(sessionsDir, id) -> SessionMeta? {
  role: id 의 저장 세션 meta 를 events 를 읽지 않고 (없으면 null)
}
export fn newMail(p) -> Mail {
  role: id(8자)·ts 를 붙인 봉투 — 주어진 id·ts 는 그대로
}
export fn findLive(sessionsDir, s) -> LiveSession {
  role: 켜진 세션 중 id 또는 제목 — 없으면 no_session, 같은 제목이 여럿 켜져 있으면 후보와 함께 bad_request
}
export fn sendMail(sessionsDir, to, p) -> SendResult {
  role: findLive 한 세션 소켓에 session.deliver — {id, to}. 붙지 못하면 no_session
}
