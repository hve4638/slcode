{
  "name": "slcode",
  "private": true,
  "type": "module",
  "version": "0.1.5",
  "description": "slcode — superlite 에이전트 하네스 — tmux 지위의 독립 프로세스가 에이전트 세션을 쥐고, 웹 모드·카드 모드가 같은 프로토콜로 붙는다",
  "bin": { "slcode": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "serve": "node dist/cli.js serve"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
